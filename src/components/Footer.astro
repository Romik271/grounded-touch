---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);
const year = new Date().getFullYear();
---

<footer class="bg-ivory pt-4 pb-14">
  <div class="container-editorial">
    <div class="pt-6 md:pt-8 grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <div class="font-serif text-2xl text-ink">
          Grounded Touch<span class="text-terra">.</span>
        </div>
        <p class="mt-3 text-sm text-stone max-w-xs leading-relaxed">
          {tr.footer.tagline}<br />{tr.footer.taglineCity}
        </p>
        <div class="mt-4 flex items-center gap-4">
          <a
            href="https://www.instagram.com/grounded.touch.munich/"
            target="_blank"
            rel="noopener noreferrer"
            data-track="instagram_footer"
            aria-label={tr.footer.instagramLabel}
            class="text-ink/70 hover:text-terra transition-colors duration-500 ease-gentle"
          >
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
            </svg>
          </a>
          <a
            href="https://wa.me/4915233935530?text=Hi%20Roman%2C%20I%20would%20like%20to%20book%20a%20massage."
            target="_blank"
            rel="noopener noreferrer"
            data-track="whatsapp_footer"
            aria-label={tr.footer.whatsappLabel}
            class="text-ink/70 hover:text-terra transition-colors duration-500 ease-gentle"
          >
            <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.447h.006c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411m-8.475 18.297h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.975 1.001-3.635-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.459-9.887 9.942-9.887 2.654 0 5.148 1.032 7.021 2.905a9.82 9.82 0 0 1 2.909 6.99c-.002 5.45-4.458 9.878-9.935 9.878"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="md:col-span-2">
        <div class="index-label mb-3">{tr.footer.site}</div>
        <ul class="space-y-1.5 text-sm text-ink/85">
          <li><a href="#approach" class="hover:text-terra">{tr.nav.approach}</a></li>
          <li><a href="#sessions" class="hover:text-terra">{tr.nav.sessions}</a></li>
          <li><a href="#faq" class="hover:text-terra">{tr.nav.faq}</a></li>
        </ul>
      </div>

      <div class="md:col-span-2">
        <div class="index-label mb-3">{tr.footer.legal}</div>
        <ul class="space-y-1.5 text-sm text-ink/85">
          <li><a href="/impressum" class="hover:text-terra">Impressum</a></li>
          <li><a href="/datenschutz" class="hover:text-terra">Datenschutz</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-6 border-t border-line flex flex-col md:flex-row md:justify-between gap-2 text-[12px] text-stone">
      <span>© {year} Grounded Touch</span>
      <span class="uppercase tracking-widelabel">{tr.footer.disclaimer}</span>
    </div>
  </div>
</footer>
