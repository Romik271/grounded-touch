---
import type { Lang } from '../i18n/strings';
import { t } from '../i18n/strings';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang);

const links = [
  { href: '#approach', label: tr.nav.approach },
  { href: '#about', label: tr.nav.about },
  { href: '#sessions', label: tr.nav.sessions },
  { href: '#faq', label: tr.nav.faq },
];

const homeHref = lang === 'de' ? '/de/' : '/';
const enHref = '/';
const deHref = '/de/';
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-ivory/90 backdrop-blur-md transition-colors duration-500">
  <div class="container-editorial flex items-center justify-between h-16 md:h-20">
    <a href={homeHref} class="font-serif text-[22px] md:text-[26px] tracking-[-0.02em] text-ink">
      Grounded Touch<span class="text-terra">.</span>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {links.map((l) => (
        <a
          href={l.href}
          class="text-[13px] text-ink/70 hover:text-ink transition-colors duration-500"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="hidden md:flex items-center gap-5">
      <div class="flex items-center gap-2 text-[12px] tracking-widelabel">
        <a href={enHref} class={`transition-colors duration-500 ${lang === 'en' ? 'text-ink' : 'text-ink/40 hover:text-ink'}`}>EN</a>
        <span class="text-ink/25">/</span>
        <a href={deHref} class={`transition-colors duration-500 ${lang === 'de' ? 'text-ink' : 'text-ink/40 hover:text-ink'}`}>DE</a>
      </div>
      <button
        type="button"
        data-cal-link="grounded-touch/60-min-thai-massage"
        data-cal-namespace="sixty"
        data-cal-config='{"layout":"month_view"}'
        class="btn-primary !py-2 !px-5 !text-[13px]"
      >
        {tr.nav.book}
      </button>
    </div>

    <button
      id="mobile-menu-toggle"
      aria-label={tr.nav.menuOpen}
      class="md:hidden flex flex-col gap-1.5 p-2"
    >
      <span class="block w-6 h-px bg-ink"></span>
      <span class="block w-6 h-px bg-ink"></span>
    </button>
  </div>

  <div id="header-rule" class="h-px w-full bg-transparent transition-colors duration-500"></div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-line bg-ivory">
    <nav class="container-editorial flex flex-col py-6 gap-5">
      {links.map((l) => (
        <a href={l.href} class="text-sm text-ink/80 hover:text-ink">
          {l.label}
        </a>
      ))}
      <div class="flex items-center gap-3 text-[12px] tracking-widelabel pt-2">
        <a href={enHref} class={lang === 'en' ? 'text-ink' : 'text-ink/50 hover:text-ink'}>EN</a>
        <span class="text-ink/25">/</span>
        <a href={deHref} class={lang === 'de' ? 'text-ink' : 'text-ink/50 hover:text-ink'}>DE</a>
      </div>
      <button
        type="button"
        data-cal-link="grounded-touch/60-min-thai-massage"
        data-cal-namespace="sixty"
        data-cal-config='{"layout":"month_view"}'
        class="btn-primary self-start mt-2"
      >
        {tr.nav.book}
      </button>
    </nav>
  </div>
</header>
<div class="h-16 md:h-20"></div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => menu.classList.add('hidden'))
  );

  // Show a hairline under the header only after scrolling
  const rule = document.getElementById('header-rule');
  const update = () => {
    if (!rule) return;
    if (window.scrollY > 8) rule.classList.replace('bg-transparent', 'bg-line');
    else rule.classList.replace('bg-line', 'bg-transparent');
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
