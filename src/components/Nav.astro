---
const links = [
  { href: '#approach', label: 'Approach' },
  { href: '#about', label: 'About' },
  { href: '#sessions', label: 'Sessions' },
  { href: '#faq', label: 'FAQ' },
];
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-50 bg-ivory/90 backdrop-blur-md transition-colors duration-500">
  <div class="container-editorial flex items-center justify-between h-16 md:h-20">
    <a href="/" class="font-serif text-[22px] md:text-[26px] tracking-[-0.02em] text-ink">
      Grounded Touch<span class="text-terra">.</span>
    </a>

    <nav class="hidden md:flex items-center gap-10">
      {links.map((l) => (
        <a
          href={l.href}
          class="text-[13px] text-ink/70 hover:text-ink transition-colors duration-500"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <button
      type="button"
      data-cal-link="grounded-touch/60-min-thai-bodywork"
      data-cal-namespace="sixty"
      data-cal-config='{"layout":"month_view"}'
      class="hidden md:inline-flex btn-primary !py-2 !px-5 !text-[13px]"
    >
      Book a session
    </button>

    <button
      id="mobile-menu-toggle"
      aria-label="Open menu"
      class="md:hidden flex flex-col gap-1.5 p-2"
    >
      <span class="block w-6 h-px bg-ink"></span>
      <span class="block w-6 h-px bg-ink"></span>
    </button>
  </div>

  <div id="header-rule" class="h-px w-full bg-transparent transition-colors duration-500"></div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-line bg-ivory">
    <nav class="container-editorial flex flex-col py-6 gap-5">
      {links.map((l) => (
        <a href={l.href} class="text-sm text-ink/80 hover:text-ink">
          {l.label}
        </a>
      ))}
      <button
        type="button"
        data-cal-link="grounded-touch/60-min-thai-bodywork"
        data-cal-namespace="sixty"
        data-cal-config='{"layout":"month_view"}'
        class="btn-primary self-start mt-2"
      >
        Book a session
      </button>
    </nav>
  </div>
</header>
<div class="h-16 md:h-20"></div>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => menu?.classList.toggle('hidden'));
  menu?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => menu.classList.add('hidden'))
  );

  // Show a hairline under the header only after scrolling
  const rule = document.getElementById('header-rule');
  const update = () => {
    if (!rule) return;
    if (window.scrollY > 8) rule.classList.replace('bg-transparent', 'bg-line');
    else rule.classList.replace('bg-line', 'bg-transparent');
  };
  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
