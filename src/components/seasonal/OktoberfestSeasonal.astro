---
// ─────────────────────────────────────────────────────────────────────────────
// OKTOBERFEST SEASONAL MESSAGE GATE — temporary.
//
// The Oktoberfest falling-decoration animation has been REMOVED. What remains is
// only the runtime gate that controls the small seasonal hero message
// ("Oktoberfest recovery" / "Release tension after long days on your feet and in
// the beer tents"), which the host pages render via the .gt-okt-note element.
//
// SEASONAL WINDOW: the message shows THROUGH 2026-10-01 in Europe/Berlin
// (Munich) local time; from 2026-10-02 00:00 Berlin it stops rendering on its
// own. The cutoff is evaluated at RUNTIME against the visitor's Berlin-local
// date (the site is a static build, so a build-time check would freeze at deploy
// time and leave the message up until the next deploy). The decision runs
// SYNCHRONOUSLY (is:inline, before the hero paints), adding .gt-okt-expired to
// <html> so the CSS below hides the copy with NO flash.
//
// To remove entirely after the season: delete this component, the
// <OktoberfestSeasonal/> include on the three pages, and the small .gt-okt-note
// copy noted there. Nothing else on the site depends on it.
//
// Dev / testing:
//   • ?okt=1  (or ?okt=on / ?oktoberfest=1)  → force the message ON, even past cutoff.
//   • ?okt=off (or ?oktoberfest=off)         → force the message OFF for this load.
// ─────────────────────────────────────────────────────────────────────────────
---

<!--
  Seasonal gate — runs SYNCHRONOUSLY (is:inline, not deferred) at this position,
  which sits before the hero on every page that includes the component. When the
  season is over it marks <html> with .gt-okt-expired so the CSS below hides the
  seasonal copy BEFORE it paints (no flash). During the season the class is
  absent and the server-rendered copy shows exactly as before.
-->
<script is:inline>
  (function () {
    var show = true;
    try {
      var p = new URLSearchParams(window.location.search);
      var okt = p.get('okt') || p.get('oktoberfest');
      if (okt === '1' || okt === 'on') {
        show = true; // dev override: force ON, even past the cutoff
      } else if (okt === 'off') {
        show = false; // dev override: force OFF for this load
      } else {
        // Berlin-local calendar date as YYYYMMDD. Reading the formatted parts by
        // type is locale-independent, and timeZone:'Europe/Berlin' means the
        // cutoff NEVER depends on the visitor's own timezone.
        var parts = new Intl.DateTimeFormat('en-US', {
          timeZone: 'Europe/Berlin',
          year: 'numeric',
          month: '2-digit',
          day: '2-digit',
        }).formatToParts(new Date());
        var f = {};
        for (var i = 0; i < parts.length; i++) f[parts[i].type] = parts[i].value;
        var ymd = parseInt(f.year + f.month + f.day, 10);
        show = ymd <= 20261001; // show through 2026-10-01 Berlin; hide from the 2nd
      }
    } catch (e) {
      show = true; // never break the page — default to showing it
    }
    if (!show) document.documentElement.classList.add('gt-okt-expired');
  })();
</script>

<style>
  /* The seasonal copy (.gt-okt-note) is rendered in the hero by the host pages,
     so it lives OUTSIDE this component's scope — hence :global(). Once the season
     is over, the inline gate above adds .gt-okt-expired to <html> before paint,
     which hides the copy with no flash. During the season the class is absent and
     the copy renders exactly as before (server-side, no JS reveal needed). */
  :global(html.gt-okt-expired .gt-okt-note) {
    display: none !important;
  }
</style>
