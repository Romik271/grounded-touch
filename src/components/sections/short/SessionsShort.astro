---
import type { Lang } from '../../../i18n/strings';
import { t } from '../../../i18n/strings';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang).short.sessions;

const calLinks = ['grounded-touch/60-min-thai-massage', 'grounded-touch/90-min-thai-massage'];
const calNamespaces = ['sixty', 'ninety'];
const trackIds = ['book_60min', 'book_90min'];
const rows = tr.rows.map((r, i) => ({
  ...r,
  calLink: calLinks[i],
  calNs: calNamespaces[i],
  trackId: trackIds[i],
}));
---

<section id="sessions" class="bg-ivory pt-6 pb-8 md:pt-8 md:pb-10 scroll-mt-[28px] md:scroll-mt-[68px]">
  <div class="container-editorial">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-10 md:mb-14">
      <div class="md:col-span-4 reveal"></div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          {tr.title}
        </h2>
        <p class="mt-5 lede">
          {tr.lede}
        </p>

        {/* TEMPORARY: September availability notice. Compact editorial note —
            not a card. It is only shown during a fixed Europe/Berlin time
            window (see the inline script below); it renders `hidden` by default
            so it occupies no space until the script reveals it. To remove later,
            delete this block, that script, and the `notice` strings in
            i18n/strings.ts (en + de). */}
        <div
          id="sept-availability-notice"
          hidden
          data-visible-from="2026-09-13T00:00"
          data-hide-from="2026-09-19T08:00"
          class="mt-6 rounded-[6px] border border-terra/30 bg-terra/[0.06] p-5 md:p-6"
        >
          <p class="index-label !text-terra">{tr.notice.heading}</p>
          <p class="mt-2 text-lg md:text-xl font-medium text-ink">{tr.notice.bodyLate}</p>
        </div>

        {/* Isolated to the notice above: reveal it ONLY within the Europe/Berlin
            window [data-visible-from, data-hide-from). The current Berlin time is
            built as a fixed-width 'YYYY-MM-DDTHH:mm' string so the cutoff compare
            is a plain lexicographic string compare. Runs synchronously (is:inline)
            so it resolves before paint — no flash. Outside the window the element
            is removed entirely (no leftover space/margin/border). Touches nothing
            else on the page. */}
        <script is:inline>
          (function () {
            var el = document.getElementById('sept-availability-notice');
            if (!el) return;
            var now;
            try {
              var parts = new Intl.DateTimeFormat('en-GB', {
                timeZone: 'Europe/Berlin',
                year: 'numeric', month: '2-digit', day: '2-digit',
                hour: '2-digit', minute: '2-digit', hourCycle: 'h23'
              }).formatToParts(new Date());
              var v = {};
              parts.forEach(function (p) { v[p.type] = p.value; });
              now = v.year + '-' + v.month + '-' + v.day + 'T' + v.hour + ':' + v.minute;
            } catch (e) {
              el.remove(); // if the Berlin time can't be read, keep it hidden (no trace)
              return;
            }
            var from = el.getAttribute('data-visible-from');
            var until = el.getAttribute('data-hide-from');
            if (now >= from && now < until) {
              el.removeAttribute('hidden'); // within the window → show
            } else {
              el.remove(); // outside the window → no leftover space/margin/border
            }
          })();
        </script>
      </div>
    </div>

    {/* TEMPORARY: Chiang Mai training / availability notice. ONE compact card
        placed above the complete 60/90-minute card group (full container width →
        above both cards on desktop, before the first card on mobile). Only the
        two dates in the final line carry modest font-weight emphasis. Rendered
        `hidden` so it occupies no space until the shared expiration script
        (below the cards) reveals it; past the Europe/Berlin cutoff it and both
        card notes are removed entirely (no leftover space). The negative top
        margin pulls the card up to ~16px below the intro (nets 16px whether the
        heading block's mb-10/md:mb-14 collapses or adds); removing the notice on
        expiry restores the section's original spacing untouched. Copy lives in
        i18n/strings.ts (short.sessions.trainingNotice, en + de). To remove later,
        delete this block, the card note, the script, and both trainingNotice +
        cardNote string blocks. */}
    <div
      data-training-expire
      hidden
      class="-mt-6 md:-mt-10 mb-4 rounded-[6px] border-l-2 border-terra bg-terra/[0.06] p-3.5"
    >
      <p class="text-[15px] font-semibold leading-[1.45] text-ink">{tr.trainingNotice.heading}</p>
      <p class="mt-1.5 text-[14px] leading-[1.45] text-ink/80">{tr.trainingNotice.body}</p>
      <p class="mt-1.5 text-[14px] leading-[1.45] text-ink/80">
        {tr.trainingNotice.finalLine.map((seg) =>
          seg.strong ? (
            <strong class="font-medium text-ink">{seg.text}</strong>
          ) : (
            <Fragment>{seg.text}</Fragment>
          ),
        )}
      </p>
    </div>

    <div class="space-y-4 md:space-y-5">
      {rows.map((r) => (
        <button
          type="button"
          data-cal-link={r.calLink}
          data-cal-namespace={r.calNs}
          data-cal-config='{"layout":"month_view"}'
          data-track={r.trackId}
          class="reveal grid grid-cols-12 gap-4 md:gap-10 items-start bg-paper hover:bg-line/50 rounded-[6px] px-5 md:px-8 py-7 md:py-10 transition-colors duration-500 ease-gentle text-left w-full"
        >
          <div class="col-span-3 md:col-span-2">
            <span class="font-serif text-5xl md:text-7xl text-ink tabular-nums leading-none">{r.duration}</span>
            <span class="ml-2 index-label">{tr.minLabel}</span>
          </div>
          <div class="col-span-9 md:col-span-7">
            <h3 class="font-serif text-2xl md:text-3xl text-ink leading-tight">{r.title}</h3>
            <p class="mt-3 text-ink/70 leading-relaxed max-w-prose2">{r.text}</p>
          </div>
          <div class="col-span-12 md:col-span-3 flex items-end justify-between md:justify-end gap-6 md:gap-8">
            <div>
              <span class="font-serif text-4xl md:text-5xl text-terra tabular-nums leading-none">{r.price}</span>
              <span class="ml-1 text-2xl md:text-3xl text-terra">€</span>
            </div>
            {/* Right-hand group: the temporary November note sits ABOVE the
                booking link within this one footer row, filling the empty space
                beside the tall price instead of adding a row below (which had
                made the cards taller). items-end keeps the booking link at the
                bottom, aligned with the price bottom. */}
            <div class="flex flex-col items-end">
              {/* TEMPORARY: November availability note. Non-interactive text (the
                  whole card is the booking control; this sits outside the booking
                  link). `hidden` until the shared expiration script reveals it,
                  removed entirely at the cutoff so the card returns to its
                  original layout. Copy: i18n short.sessions.cardNote (en + de). */}
              <p
                data-training-expire
                data-show-from="2026-10-16T08:00:00+02:00"
                hidden
                class="mb-1 text-right text-[14px] font-medium leading-[1.45] text-terra"
              >
                {tr.cardNote}
              </p>
              <span class="btn-link !text-terra">
                {tr.bookLabel}
                <span aria-hidden="true">→</span>
              </span>
            </div>
          </div>
        </button>
      ))}
    </div>

    {/* Shared expiration for all temporary elements: the notice above the cards
        AND both per-card November notes (every [data-training-expire] element).
        Placed after the cards so all three exist when the script first runs.
        All disappear together at the fixed cutoff (9 Nov 2026 00:00 Europe/Berlin,
        written with its explicit +01:00 offset so the compare is the SAME absolute
        instant in every visitor timezone), removed so no empty wrapper or reserved
        spacing remains. An element may additionally carry data-show-from to delay
        its appearance until a start instant (the card notes: 16 Oct 2026 08:00
        Berlin); before then it stays `hidden` (display:none → no empty row/gap).
        Elements ship `hidden`, so nothing flashes before the first check. Re-checks
        on initial load, when a backgrounded tab returns, on bfcache restore, and on
        client-side navigation (astro:page-load, if ever added). A browser-limit-safe
        chained timeout wakes at the next boundary (a note's start, or the cutoff)
        for a page kept open across it. Idempotent — listeners bind once. */}
    <script is:inline>
      (function () {
        var CUTOFF = Date.parse('2026-11-09T00:00:00+01:00');
        var MAX_DELAY = 2147483647; // setTimeout 32-bit cap (~24.8 days)
        var timer = null;

        function clear() { if (timer) { clearTimeout(timer); timer = null; } }

        function apply() {
          var els = document.querySelectorAll('[data-training-expire]');
          if (!els.length) { clear(); return; }
          var now = Date.now();
          if (now >= CUTOFF) {
            clear();
            els.forEach(function (el) { el.remove(); }); // no leftover space
            return;
          }
          // Shared cutoff is the next boundary unless an element is still waiting
          // for its own start time (data-show-from) sooner.
          var next = CUTOFF;
          els.forEach(function (el) {
            var from = el.getAttribute('data-show-from');
            var start = from ? Date.parse(from) : 0; // no attr → show immediately
            if (now >= start) {
              el.removeAttribute('hidden'); // within its window → show
            } else {
              el.setAttribute('hidden', ''); // before its start → hidden, no space
              if (start < next) next = start; // wake to reveal it on time
            }
          });
          clear();
          // Chain the timeout so a wait longer than the 32-bit cap never
          // overflows (an overflow would fire immediately and hide it early).
          var remaining = next - now;
          timer = setTimeout(apply, remaining > MAX_DELAY ? MAX_DELAY : remaining);
        }

        apply();

        if (!window.__trainingNoticeBound) {
          window.__trainingNoticeBound = true;
          document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') apply();
          });
          window.addEventListener('pageshow', apply);
          document.addEventListener('astro:page-load', apply);
        }
      })();
    </script>

    <div class="reveal mt-5 md:mt-6">
      <a
        href="https://wa.me/4915233935530?text=Hi%20Roman%2C%20I%20would%20like%20to%20book%20a%20massage."
        target="_blank"
        rel="noopener"
        data-track="whatsapp_contact"
        class="inline-flex items-center gap-3 rounded-full border border-ink/25 text-ink px-7 py-4 text-base md:text-lg transition-colors duration-500 ease-gentle hover:border-ink hover:bg-ink hover:text-ivory"
        aria-label={tr.whatsappLabel}
      >
        <svg
          aria-hidden="true"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.447h.006c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411m-8.475 18.297h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.975 1.001-3.635-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.459-9.887 9.942-9.887 2.654 0 5.148 1.032 7.021 2.905a9.82 9.82 0 0 1 2.909 6.99c-.002 5.45-4.458 9.878-9.935 9.878"/>
        </svg>
        <span>{tr.whatsappLabel}</span>
      </a>
    </div>
  </div>
</section>
