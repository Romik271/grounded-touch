---
const principles = [
  { word: 'Slow', text: 'The pace follows your body. Nothing is rushed. Time is given where it is needed.' },
  { word: 'Attentive', text: 'Listen before applying pressure. I react to what your body communicates.' },
  { word: 'Responsive', text: 'No two sessions are exactly the same. The work adapts to where you hold tension and what you need.' },
];
---

<section class="bg-ivory pt-6 pb-6 md:pt-8 md:pb-8">
  <div class="container-editorial">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-10 md:mb-14">
      <div class="md:col-span-4 reveal"></div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          Three principles guide every session.
        </h2>
      </div>
    </div>

    <div class="reveal principles-row">
      <div class="principles-grid">
        {principles.map((p) => (
          <div class="principles-cell">
            <h3 class="font-serif text-2xl md:text-3xl text-ink">{p.word}</h3>
            <p class="mt-2 text-ink/80 leading-relaxed">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <style>
    .principles-row {
      border-top: 1px solid #D8CDB8; /* line */
    }
    .principles-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .principles-cell {
      padding: 1.5rem 0;
    }
    @media (min-width: 768px) {
      .principles-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
      .principles-cell {
        padding: 2rem;
        border-left: 1px solid #D8CDB8;
      }
      .principles-cell:first-child {
        padding-left: 0;
        border-left: none;
      }
      .principles-cell:last-child {
        padding-right: 0;
      }
    }
  </style>
</section>
