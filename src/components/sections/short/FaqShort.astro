---
import type { Lang } from '../../../i18n/strings';
import { t } from '../../../i18n/strings';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang).short.faq;

// Analytics button_ids, one per FAQ item, in the same order the items are
// defined for both languages. Identical values on EN and DE.
const faqTrackIds = [
  'faq_how_does_it_feel',
  'faq_where_does_it_happen',
  'faq_mobile_massage',
  'faq_what_should_i_wear',
  'faq_payment',
];

// Some answers embed a single inline link (e.g. the WhatsApp destination).
// Split the answer around the link phrase so the middle becomes an <a> while
// the surrounding text keeps its whitespace-pre-line formatting.
type FaqItem = (typeof tr.items)[number] & {
  link?: { text: string; href: string; track: string; rel?: string };
};
const items = tr.items as readonly FaqItem[];
function splitAnswer(f: FaqItem) {
  if (!f.link) return null;
  const idx = f.a.indexOf(f.link.text);
  if (idx === -1) return null;
  return {
    before: f.a.slice(0, idx),
    after: f.a.slice(idx + f.link.text.length),
  };
}
---

<section id="faq" class="bg-ivory pt-6 pb-10 md:pt-8 md:pb-12">
  <div class="container-editorial">
    <div class="reveal mb-4 md:mb-6">
      <div class="index-label">{tr.label}</div>
    </div>

    <div class="max-w-4xl border-t border-ink/20">
      {items.map((f, i) => {
        const parts = splitAnswer(f);
        return (
        <details class="reveal group border-b border-ink/20 py-5 md:py-6">
          <summary data-track={faqTrackIds[i]} class="flex items-center justify-between gap-6 cursor-pointer list-none">
            <span class="font-serif text-xl md:text-2xl text-ink pr-4">{f.q}</span>
            <span
              class="flex-shrink-0 w-8 h-8 flex items-center justify-center text-ink/60 group-hover:text-ink transition-transform duration-500 ease-gentle group-open:rotate-45"
              aria-hidden="true"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
                <path d="M7 1v12M1 7h12" />
              </svg>
            </span>
          </summary>
          <div class="pt-4 pr-10 text-ink/75 leading-relaxed max-w-prose2 whitespace-pre-line">
            {parts && f.link ? (
              <Fragment>
                {parts.before}
                <a
                  href={f.link.href}
                  target="_blank"
                  rel={f.link.rel ?? 'noopener'}
                  data-track={f.link.track}
                  class="text-ink border-b border-ink/40 pb-0.5 transition-colors duration-500 ease-gentle hover:border-terra hover:text-terra"
                >
                  {f.link.text}
                </a>
                {parts.after}
              </Fragment>
            ) : (
              f.a
            )}
          </div>
        </details>
        );
      })}
    </div>
  </div>

  <script>
    // Track only the click that EXPANDS a FAQ item, exactly once per click.
    // The global analytics listener fires on any [data-track] click in the
    // capture phase (before <details> toggles). So we keep data-track present
    // only while the item is closed, and strip it once open — the closing
    // click then has no attribute and fires nothing. Re-armed on close.
    document.querySelectorAll('#faq details').forEach((details) => {
      const summary = details.querySelector('summary');
      if (!summary) return;
      const trackId = summary.getAttribute('data-track');
      if (!trackId) return;
      details.addEventListener('toggle', () => {
        if (details.open) {
          summary.removeAttribute('data-track');
        } else {
          summary.setAttribute('data-track', trackId);
        }
      });
    });
  </script>
</section>
