---
const reviews = [
  {
    name: 'Elke Geibig',
    initials: 'EG',
    text: 'Ich hatte heute eine Massage bei Roman und mich direkt wohlgefühlt. Roman arbeitet sehr aufmerksam und ist auf meine Bedürfnisse eingegangen. Besonders für eine verspannte Stelle an meiner Hüfte hat er sich viel Zeit genommen. Nach der Massage fühlte ich mich deutlich entspannter. Klare Empfehlung!',
    truncated: false,
    href: 'https://maps.app.goo.gl/63GcQEmTkTyY44f8A',
  },
  {
    name: 'Matze Dawedla',
    initials: 'MD',
    text: "Roman is an excellent masseur! You'll just need a place where you can lie down, he takes care of the rest. His thai massages are highly individual to your needs, whether your legs hurt from the last hike, or your shoulders and neck are tense from your exhausting day at the office. If you're around Munich and would like to try out a Thai massage at the comfort of your own home, definitely give it a go!",
    truncated: false,
    href: 'https://maps.app.goo.gl/BrMcQr8XPPUmFB2u8',
  },
  {
    name: 'Kelvin Strausman',
    initials: 'KS',
    text: 'Roman has a very soft, but firm touch. His massage was very thorough, deep, penetrating, at the same smooth and controlled. It felt as if he was touching, stretching and manipulating every muscle, kneading it softly like a dough and stretching it out.',
    truncated: false,
    href: 'https://maps.app.goo.gl/63GcQEmTkTyY44f8A',
  },
  {
    name: 'Natalia Hanhart-Alabyan',
    initials: 'NH',
    text: 'Fantastic Thai massage! Roman is very professional and skilled, and the atmosphere was clean and relaxing. I left feeling refreshed and much better. Highly recommended-I’ll definitely be back!',
    truncated: false,
    href: 'https://maps.app.goo.gl/pcu3DjTKZ4iNbGQA6',
  },
  {
    name: 'Peter Lutzenberger',
    initials: 'PL',
    text: 'Sehr gute Tai Massage.\nFreu mich schon aufs nächste Mal. Absolut empfehlenswert 👍\nSehr achtsame und gute Massage.',
    truncated: false,
    href: 'https://maps.app.goo.gl/9DrsKd8J3qsfyXWH9',
  },
];

// Every review card links to the same public Google Maps reviews page.
const googleReviewsUrl = 'https://www.google.com/maps/place/Grounded+Touch+Massage/@48.163404,11.4184631,11z/data=!4m8!3m7!1s0x6ce2ecc61bd60bc5:0xa21970b570f4f98a!8m2!3d48.1635223!4d11.5836108!9m1!1b1!16s%2Fg%2F11zctqjhqs!5m1!1e2';

// Pick 4 of the 5 reviews at build time for desktop; then pick one of those
// 4 to hide on mobile so mobile shows 3. Selection is stable per build.
const shuffled = reviews.map((r) => ({ r, s: Math.random() })).sort((a, b) => a.s - b.s).map((x) => x.r);
const displayedReviews = shuffled.slice(0, 4);
const hiddenOnMobileIndex = Math.floor(Math.random() * displayedReviews.length);
---

<section id="reviews" class="bg-ivory py-8 md:py-10">
  <div class="container-editorial">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-8 md:mb-12">
      <div class="md:col-span-4 reveal"></div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          What clients say.
        </h2>
        <a
          href="https://www.google.com/search?sca_esv=b3fbd9fc0a9dd966&sxsrf=APpeQnsdLfdCC_h5WbRth9Ukr0LsCwhL0A:1784098081478&q=Grounded+Touch+Massage&si=APenkKm7iecQ4G6P-TsbSMFKIQtv3EFIqRAFw-i8uEbk55Z-_70cRwsjW6vBLkx1fxeHA3w_FOSvGEhuq-7vHfY1tKUM6rw3_gB9m6BqEq_lTAW3L7gvhOc%3D&uds=AJ5uw1_sainNaeRyvmf1hc0XfC1vqRyroaRGOOnZM-QF5utzCHQLOGAsIbDBe75C1u0cg_sFmsjmIIHNQ36RSNGPoCa15F5b4wFzNcNYR8eYYQ5y7o8axqu8hd_N88x3OAGOvnRMj_Me&sa=X&ved=2ahUKEwiM94-ji9SVAxVXA9sEHX6OHhoQ3PALegQIGBAE&biw=1460&bih=825&dpr=2"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="See all Grounded Touch reviews on Google"
          class="mt-5 inline-flex items-center gap-3 text-sm text-ink/80 hover:text-ink transition-colors duration-500 ease-gentle"
        >
          <span class="flex items-center gap-0.5 text-terra" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg width="13" height="13" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                <path d="M6 .75l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.633 2.91 10.259l.59-3.44L1 4.382l3.455-.502L6 .75z" />
              </svg>
            ))}
          </span>
          <span class="tabular-nums">5.0</span>
          <span class="text-stone/60" aria-hidden="true">·</span>
          <span class="inline-flex items-center gap-1.5">
            on
            <svg
              aria-hidden="true"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              class="opacity-90"
            >
              <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.44c-.28 1.42-1.1 2.63-2.33 3.45v2.85h3.77c2.2-2.03 3.61-5.02 3.61-8.54z"/>
              <path fill="#34A853" d="M12 24c3.15 0 5.79-1.05 7.72-2.83l-3.77-2.85c-1.05.7-2.39 1.12-3.95 1.12-3.04 0-5.62-2.05-6.54-4.81H1.55v2.94C3.48 21.31 7.42 24 12 24z"/>
              <path fill="#FBBC05" d="M5.46 14.63c-.23-.7-.37-1.44-.37-2.23s.14-1.53.37-2.23V7.23H1.55A11.98 11.98 0 000 12.4c0 1.9.45 3.7 1.25 5.29l4.21-3.06z"/>
              <path fill="#EA4335" d="M12 4.75c1.71 0 3.25.59 4.47 1.75l3.35-3.35C17.79 1.26 15.15 0 12 0 7.42 0 3.48 2.69 1.55 6.6l3.91 3.06C6.38 6.9 8.96 4.75 12 4.75z"/>
            </svg>
            <span>Google</span>
          </span>
        </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
      {displayedReviews.map((r, i) => (
        <div
          data-review-card
          class={`review-card reveal bg-paper rounded-[6px] px-5 md:px-7 py-6 md:py-8 ${i === hiddenOnMobileIndex ? 'hidden md:flex md:flex-col' : 'flex flex-col'}`}
        >
          <div class="flex items-center gap-3">
            <span
              aria-hidden="true"
              class="flex-shrink-0 w-9 h-9 rounded-full border border-ink/15 bg-ivory flex items-center justify-center font-serif text-xs text-ink/75 tracking-widelabel"
            >
              {r.initials}
            </span>
            <div class="min-w-0 flex-1">
              <div class="font-serif text-base md:text-lg text-ink leading-tight truncate">{r.name}</div>
              <div class="mt-0.5 flex items-center gap-2">
                <span class="flex items-center gap-0.5 text-terra" aria-label="5 out of 5 stars">
                  {Array.from({ length: 5 }).map(() => (
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                      <path d="M6 .75l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.633 2.91 10.259l.59-3.44L1 4.382l3.455-.502L6 .75z" />
                    </svg>
                  ))}
                </span>
                <span class="index-label !text-[10px] !tracking-widelabel text-stone">Google review</span>
              </div>
            </div>
            <svg
              aria-hidden="true"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              class="flex-shrink-0 opacity-90"
            >
              <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.44c-.28 1.42-1.1 2.63-2.33 3.45v2.85h3.77c2.2-2.03 3.61-5.02 3.61-8.54z"/>
              <path fill="#34A853" d="M12 24c3.15 0 5.79-1.05 7.72-2.83l-3.77-2.85c-1.05.7-2.39 1.12-3.95 1.12-3.04 0-5.62-2.05-6.54-4.81H1.55v2.94C3.48 21.31 7.42 24 12 24z"/>
              <path fill="#FBBC05" d="M5.46 14.63c-.23-.7-.37-1.44-.37-2.23s.14-1.53.37-2.23V7.23H1.55A11.98 11.98 0 000 12.4c0 1.9.45 3.7 1.25 5.29l4.21-3.06z"/>
              <path fill="#EA4335" d="M12 4.75c1.71 0 3.25.59 4.47 1.75l3.35-3.35C17.79 1.26 15.15 0 12 0 7.42 0 3.48 2.69 1.55 6.6l3.91 3.06C6.38 6.9 8.96 4.75 12 4.75z"/>
            </svg>
          </div>

          <div class="review-body mt-4">
            <p class="review-text text-ink/80 leading-relaxed whitespace-pre-line">
              {r.text}
            </p>
            <a
              href={googleReviewsUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-review-toggle
              aria-expanded="false"
              aria-label={`Read ${r.name}'s review`}
              class="review-link text-[13px] text-terra transition-colors duration-500 ease-gentle hover:text-ink"
            >
              <span class="review-link-label" data-collapsed-label>Read full review →</span>
              <span class="review-link-label hidden" data-expanded-label>See on Google Maps →</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <style>
    .review-body {
      position: relative;
      overflow: hidden;
      transition: max-height 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    .review-text {
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .review-link {
      display: block;
      text-align: right;
      margin-top: 0.75rem;
    }
    @media (min-width: 768px) {
      .review-text {
        -webkit-line-clamp: 3;
        padding-right: 8rem;
      }
      .review-link {
        position: absolute;
        right: 0;
        bottom: 0;
        margin-top: 0;
      }
    }
    .review-card.is-expanded .review-body {
      overflow: visible !important;
      max-height: none !important;
    }
    .review-card.is-expanded .review-text {
      display: block !important;
      -webkit-line-clamp: none !important;
      -webkit-box-orient: horizontal !important;
      overflow: visible !important;
      max-height: none !important;
      padding-right: 0 !important;
      -webkit-mask-image: none !important;
              mask-image: none !important;
    }
    @media (min-width: 768px) {
      .review-card.is-expanded .review-link {
        position: static;
        text-align: right;
        margin-top: 0.75rem;
      }
    }
  </style>

  <script>
    (function () {
      const cards = document.querySelectorAll('#reviews [data-review-card]');

      const setLabels = (toggle, expanded) => {
        const collapsedLabel = toggle.querySelector('[data-collapsed-label]');
        const expandedLabel = toggle.querySelector('[data-expanded-label]');
        if (!collapsedLabel || !expandedLabel) return;
        collapsedLabel.classList.toggle('hidden', expanded);
        expandedLabel.classList.toggle('hidden', !expanded);
        toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
      };

      const expand = (card) => {
        const body = card.querySelector('.review-body');
        const toggle = card.querySelector('[data-review-toggle]');
        if (!body || !toggle) return;
        const startHeight = body.scrollHeight;
        body.style.maxHeight = startHeight + 'px';
        void body.offsetHeight;
        card.classList.add('is-expanded');
        setLabels(toggle, true);
        const target = body.scrollHeight;
        body.style.maxHeight = target + 'px';
        const done = () => {
          body.style.maxHeight = '';
          body.removeEventListener('transitionend', done);
        };
        body.addEventListener('transitionend', done);
      };

      cards.forEach((card) => {
        const toggle = card.querySelector('[data-review-toggle]');
        if (!toggle) return;
        toggle.addEventListener('click', (e) => {
          if (card.classList.contains('is-expanded')) {
            // Second click: let the anchor navigate to Google Maps.
            return;
          }
          e.preventDefault();
          expand(card);
        });
      });
    })();
  </script>
</section>
