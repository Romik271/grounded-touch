---
import EditorialImage from '../EditorialImage.astro';
---

<section id="about" class="bg-ivory py-16 md:py-24">
  <div class="container-editorial">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-8 md:mb-12">
      <div class="md:col-span-4 reveal">
        <div class="index-label">N° 08 — About</div>
      </div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          About.
        </h2>
      </div>
    </div>

    <div class="max-w-4xl border-t border-ink/20">
      <details class="reveal group border-b border-ink/20 py-5 md:py-6">
        <summary class="flex items-center justify-between gap-6 cursor-pointer list-none">
          <span class="font-serif text-xl md:text-2xl text-ink pr-4">
            A short introduction about the person behind Grounded Touch.
          </span>
          <span
            class="flex-shrink-0 w-8 h-8 flex items-center justify-center text-ink/60 group-hover:text-ink transition-transform duration-500 ease-gentle group-open:rotate-45"
            aria-hidden="true"
          >
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
              <path d="M7 1v12M1 7h12" />
            </svg>
          </span>
        </summary>
        <div class="pt-6 grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
          <div class="md:col-span-5">
            <EditorialImage
              src="/images/about.jpeg"
              alt="Portrait — Grounded Touch"
              ratio="4/5"
              variant="stone"
            />
          </div>
          <div class="md:col-span-7 md:pt-2 text-ink/75 leading-relaxed max-w-prose2">
            <p>My name is Roman.</p>
            <p class="mt-3">I came to bodywork through movement — through dance, climbing, walking, and the simple experience of living in a body every day.</p>
            <p class="mt-3">Over time, I became interested not only in how the body moves, but in how it holds tension, adapts, and finds its way back to ease.</p>
            <p class="mt-3">My approach is slow and attentive. I do not try to force change, but rather give your body and mind space for relaxation and joy.</p>
            <p class="mt-3">Each session is a conversation through touch — adjusting to what your body is asking for in that moment.</p>
            <p class="mt-3">Grounded Touch is a small private space in Munich where you can slow down, disconnect, and give your body some undivided attention.</p>
          </div>
        </div>
      </details>
    </div>
  </div>
</section>
