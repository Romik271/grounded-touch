---
import EditorialImage from '../EditorialImage.astro';
import type { Lang } from '../../i18n/strings';
import { t } from '../../i18n/strings';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang).hero;
---

<section class="bg-ivory">
  <div class="container-editorial pt-4 md:pt-8 pb-8 md:pb-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      <div class="lg:col-span-7 reveal">
        <h1 class="h-display">
          {tr.titleA}<span class="text-stone">{tr.titleB}</span>
        </h1>

        <p class="mt-6 lede whitespace-pre-line">
          {tr.lede}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-cal-link="grounded-touch/60-min-thai-massage"
            data-cal-namespace="sixty"
            data-cal-config='{"layout":"month_view"}'
            class="btn-primary"
          >
            {tr.cta}
            <span aria-hidden="true">→</span>
          </button>
          <a href="#approach" class="btn-outline">
            {tr.secondary}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <EditorialImage
          src="/images/hero-opt.jpg"
          webp="/images/hero-opt.webp"
          alt={tr.alt}
          ratio="3/4"
          variant="stone"
          priority
        />
      </div>
    </div>
  </div>

  <div class="container-editorial">
    <div class="rule"></div>
  </div>
</section>
