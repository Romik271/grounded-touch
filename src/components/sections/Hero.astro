---
import EditorialImage from '../EditorialImage.astro';
---

<section class="bg-ivory">
  <div class="container-editorial pt-4 md:pt-8 pb-8 md:pb-10">
    <div class="flex items-center justify-between text-[11px] uppercase tracking-widelabel text-stone mb-10 md:mb-14">
      <span>Thai Bodywork & Massage — Munich Schwabing</span>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      <div class="lg:col-span-7 reveal">
        <h1 class="h-display">
          Your body deserves time <span class="text-stone">to recover.</span>
        </h1>

        <p class="mt-6 lede">
          Thai bodywork and massage in Munich Schwabing. Attentive sessions for tired legs, feet, and the whole body.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <button
            type="button"
            data-cal-link="grounded-touch/60-min-thai-bodywork"
            data-cal-namespace="sixty"
            data-cal-config='{"layout":"month_view"}'
            class="btn-primary"
          >
            Book a session
            <span aria-hidden="true">→</span>
          </button>
          <a href="#approach" class="btn-outline">
            The approach
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 reveal">
        <EditorialImage
          src="/images/hero-opt.jpg"
          webp="/images/hero-opt.webp"
          alt="Bodywork on the leg in a warm daylit studio — Grounded Touch, Munich"
          ratio="3/4"
          variant="stone"
          priority
        />
      </div>
    </div>
  </div>

  <div class="container-editorial">
    <div class="rule"></div>
  </div>
</section>
