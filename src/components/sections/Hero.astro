---
import EditorialImage from '../EditorialImage.astro';
import type { Lang } from '../../i18n/strings';
import { t } from '../../i18n/strings';

interface Props {
  lang?: Lang;
  // Optional secondary trust marker rendered between the hero description and
  // the CTA. Only passed on /long (experimental) — omitted elsewhere so / and
  // /de/ are unchanged.
  trustMarker?: string;
}

const { lang = 'en', trustMarker } = Astro.props;
const tr = t(lang).hero;
---

<section class="bg-ivory">
  <div class="container-editorial pt-4 md:pt-8 pb-8 md:pb-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
      <div class="lg:col-span-7 reveal">
        <h1 class="h-display">
          {tr.titleA}<span class="text-stone">{tr.titleB}</span>
        </h1>

        <p class="mt-6 lede whitespace-pre-line">
          {tr.lede}
        </p>

        {trustMarker && (
          <p class="hero-trust mt-6 mb-2 flex items-center gap-1.5 text-[14px] md:text-[15px] font-normal leading-tight text-stone">
            <svg
              class="flex-shrink-0"
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 6L9 17l-5-5" />
            </svg>
            <span>{trustMarker}</span>
          </p>
        )}

        <div class={`${trustMarker ? 'mt-0' : 'mt-8'} flex flex-wrap items-center gap-3`}>
          <button
            type="button"
            data-cal-link="grounded-touch/60-min-thai-massage"
            data-cal-namespace="sixty"
            data-cal-config='{"layout":"month_view"}'
            class="btn-primary"
          >
            {tr.cta}
            <span aria-hidden="true">→</span>
          </button>
          <a href="#approach" class="btn-outline">
            {tr.secondary}
          </a>
        </div>
      </div>

      <div class="lg:col-span-5">
        <EditorialImage
          src="/images/hero-opt.jpg"
          webp="/images/hero-opt.webp"
          alt={tr.alt}
          ratio="3/4"
          variant="stone"
          priority
        />
      </div>
    </div>
  </div>

  <div class="container-editorial">
    <div class="rule"></div>
  </div>
</section>
