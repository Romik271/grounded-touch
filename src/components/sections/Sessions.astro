---
const rows = [
  {
    duration: '60',
    price: '65',
    title: 'A short pause',
    text: 'Time enough to settle from head to feet. Ideal for a first visit.',
    calLink: 'grounded-touch/60-min',
    calNs: 'sixty',
    calHref: 'https://cal.com/grounded-touch/60-min?overlayCalendar=true',
  },
  {
    duration: '90',
    price: '85',
    title: 'A longer stay',
    text: 'More room for the body to unwind. The pace slows further; the work reaches deeper without pushing.',
    calLink: 'grounded-touch/90-min-thai-massage',
    calNs: 'ninety',
    calHref: 'https://cal.com/grounded-touch/90-min-thai-massage?overlayCalendar=true',
  },
];
---

<section id="sessions" class="bg-ivory py-16 md:py-24">
  <div class="container-editorial">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-10 md:mb-14">
      <div class="md:col-span-4 reveal">
        <div class="index-label">N° 04 — Rates</div>
      </div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          Two lengths.<br />
          Same unhurried care.
        </h2>
        <p class="mt-5 lede">
          Payment in cash or by transfer after the session. No packages, no upselling, no extras.
        </p>
      </div>
    </div>

    <div class="border-t border-ink/20">
      {rows.map((r) => (
        <div class="reveal grid grid-cols-12 gap-4 md:gap-10 items-baseline border-b border-ink/20 py-7 md:py-10">
          <div class="col-span-3 md:col-span-2">
            <span class="font-serif text-5xl md:text-7xl text-ink tabular-nums leading-none">{r.duration}</span>
            <span class="ml-2 index-label">min</span>
          </div>
          <div class="col-span-6 md:col-span-6">
            <h3 class="font-serif text-2xl md:text-3xl text-ink leading-tight">{r.title}</h3>
            <p class="mt-3 text-ink/70 leading-relaxed max-w-prose2">{r.text}</p>
          </div>
          <div class="col-span-3 md:col-span-2 text-right">
            <span class="font-serif text-4xl md:text-5xl text-ink tabular-nums leading-none">{r.price}</span>
            <span class="ml-1 text-2xl md:text-3xl text-stone">€</span>
          </div>
          <div class="col-span-12 md:col-span-2 md:text-right">
            <a
              href={r.calHref}
              data-cal-link={r.calLink}
              data-cal-namespace={r.calNs}
              data-cal-config='{"layout":"month_view"}'
              class="btn-link"
            >
              Book
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
