---
import EditorialImage from '../EditorialImage.astro';
---

<section class="bg-ivory pt-2 pb-16 md:pb-24">
  <div class="container-editorial">
    <div class="reveal bg-cocoa text-ivory overflow-hidden rounded-[8px]">
      <div class="grid grid-cols-1 md:grid-cols-12">
        <div class="md:col-span-6 order-2 md:order-1">
          <EditorialImage
            src="/images/cta.jpg"
            alt="Studio interior — linen, wood, warm daylight"
            ratio="16/10"
            variant="wood"
          />
        </div>

        <div class="md:col-span-6 order-1 md:order-2 flex flex-col justify-between p-8 md:p-12">
          <div class="flex items-center justify-between text-[11px] uppercase tracking-widelabel text-ivory/50">
            <span>Grounded Touch</span>
            <span>Munich · By appointment</span>
          </div>

          <div class="py-10 md:py-14">
            <h2 class="font-serif font-medium text-4xl md:text-5xl leading-[1.05] tracking-[-0.015em]">
              Give your body<br />
              an hour of quiet.
            </h2>
            <p class="mt-5 text-ivory/70 leading-relaxed max-w-md">
              A private Munich studio, warm daylight,
              and time set aside for the parts of you that carry the day.
            </p>

            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href="https://cal.com/grounded-touch/60-min?overlayCalendar=true"
                data-cal-link="grounded-touch/60-min"
                data-cal-namespace="sixty"
                data-cal-config='{"layout":"month_view"}'
                class="inline-flex items-center gap-2 rounded-full bg-ivory text-cocoa px-6 py-3 text-sm hover:bg-terra hover:text-ivory transition-colors duration-500"
              >
                Book a session
                <span aria-hidden="true">→</span>
              </a>
              <a href="mailto:hello@groundedtouch.de" class="inline-flex items-center gap-2 rounded-full border border-ivory/25 text-ivory px-6 py-3 text-sm hover:bg-ivory hover:text-cocoa transition-colors duration-500">
                Write a note
              </a>
            </div>
          </div>

          <div class="grid grid-cols-3 gap-6 text-[13px] pt-6 border-t border-ivory/15">
            <div>
              <div class="text-ivory/50 text-[11px] uppercase tracking-widelabel mb-1">60 min</div>
              <div>65 €</div>
            </div>
            <div>
              <div class="text-ivory/50 text-[11px] uppercase tracking-widelabel mb-1">90 min</div>
              <div>85 €</div>
            </div>
            <div>
              <div class="text-ivory/50 text-[11px] uppercase tracking-widelabel mb-1">Hours</div>
              <div>Tue — Sat</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
