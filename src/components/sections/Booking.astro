---
import type { Lang } from '../../i18n/strings';
import { t } from '../../i18n/strings';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang).sessions;
---

<section id="booking" class="bg-ivory pt-8 pb-2 md:pt-10 md:pb-4">
  <div class="container-editorial">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-4 md:mb-6">
      <div class="md:col-span-4 reveal">
        <div class="index-label">{tr.bookingLabel}</div>
      </div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          {tr.bookingTitle}
        </h2>
        <p class="mt-5 lede">
          {tr.bookingLede}
        </p>
        <p class="mt-4">
          <a
            href="https://wa.me/4915233935530?text=Hi%20Roman%2C%20I%20would%20like%20to%20book%20a%20massage."
            target="_blank"
            rel="noopener"
            data-track="whatsapp_contact"
            class="btn-link"
            aria-label="WhatsApp"
          >
            <svg
              aria-hidden="true"
              width="14"
              height="14"
              viewBox="0 0 14 14"
              fill="none"
              stroke="currentColor"
              stroke-width="1.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M2 12l.9-2.7A5 5 0 1 1 4.7 11L2 12z" />
              <path d="M5.2 5.6c.1.7.6 1.7 1.5 2.4.8.6 1.6 1 2.3 1" />
            </svg>
            {tr.whatsapp}
          </a>
        </p>
      </div>
    </div>

    <div class="reveal cal-embed-wrap">
      <div class="border border-ink/15 bg-ivory rounded-[6px] overflow-hidden">
        <div id="cal-booking-inline" style="width:100%;min-width:320px;"></div>
      </div>
    </div>
  </div>

  <style>
    #cal-booking-inline { min-height: 520px; }
    #cal-booking-inline iframe { display: block; width: 100%; }
    @media (max-width: 767px) {
      #cal-booking-inline { min-height: 460px; }
    }
  </style>

  <script is:inline>
    // /long only: this inline calendar legitimately needs embed.js at load.
    // Initialize the shared sixty/ninety namespaces + analytics events too, so
    // the popup booking buttons and booking-recovery still work here (embed.js's
    // native click handler needs those namespaces defined).
    if (typeof window.calEmbedInit === "function") window.calEmbedInit();

    Cal("init", "booking", { origin: "https://cal.com" });
    Cal.ns.booking("inline", {
      elementOrSelector: "#cal-booking-inline",
      calLink: "grounded-touch/60-90-min-thai-massage",
      config: { layout: "month_view", theme: "light" },
    });
    Cal.ns.booking("ui", {
      hideEventTypeDetails: false,
      layout: "month_view",
      cssVarsPerTheme: {
        light: {
          "cal-brand": "#A54A28"
        }
      }
    });
  </script>
</section>
