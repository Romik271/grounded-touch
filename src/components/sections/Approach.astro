---
import type { Lang } from '../../i18n/strings';
import { t } from '../../i18n/strings';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const tr = t(lang).approach;
const principles = tr.principles;
---

<section id="approach" class="bg-ivory py-8 md:py-10">
  <div class="container-editorial">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-10 md:mb-14">
      <div class="md:col-span-4 reveal">
        <div class="index-label">{tr.label}</div>
      </div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          {tr.titleA}<br />
          {tr.titleB}
        </h2>
        <p class="mt-5 lede">
          {tr.lede}
        </p>
      </div>
    </div>

    <div class="border-t border-line">
      {principles.map((p) => (
        <div class="reveal grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-10 border-b border-line py-7 md:py-10">
          <div class="md:col-span-2 index-num">{p.n}</div>
          <div class="md:col-span-4">
            <h3 class="font-serif text-3xl md:text-4xl text-ink">{p.word}</h3>
          </div>
          <div class="md:col-span-6">
            <p class="text-ink/80 leading-relaxed max-w-prose2">{p.text}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
