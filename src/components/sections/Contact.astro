---

<section id="contact" class="bg-ivory pb-16 md:pb-24">
  <div class="container-editorial">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-8 md:mb-12">
      <div class="md:col-span-4 reveal">
        <div class="index-label">N° 08 — Contact</div>
      </div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          Write whenever you need to.
        </h2>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-6 reveal">
        <div class="index-label mb-3">Email</div>
        <a
          href="mailto:hello@groundedtouch.de"
          class="font-serif text-3xl md:text-4xl text-ink border-b border-ink/40 hover:border-terra hover:text-terra pb-2 transition-colors duration-500"
        >
          hello@groundedtouch.de
        </a>
      </div>

      <div class="md:col-span-6 reveal grid grid-cols-2 gap-8">
        <div>
          <div class="index-label mb-3">Studio</div>
          <p class="text-ink/85 leading-relaxed">
            Munich, Germany<br />
            <span class="text-stone text-sm">Address shared upon booking</span>
          </p>
        </div>
        <div>
          <div class="index-label mb-3">Hours</div>
          <p class="text-ink/85 leading-relaxed">
            By appointment<br />
            <span class="text-stone text-sm">Tue — Sat</span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
