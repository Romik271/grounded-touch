---
/*
  AnalyticsConsent — the PRODUCTION analytics consent banner.

  It is the only UI that decides analytics on/off. It never touches analytics
  directly: it calls the central consent API (window.gtConsent.grant / .deny)
  defined in src/scripts/analytics.ts, which owns the cookie, the ids, custom
  events, and Vercel Analytics. This component only renders and shows/hides.

  Behaviour:
    • Shows automatically when consent is undecided (no gt_analytics_consent
      cookie). Stays hidden when the visitor already granted or denied.
    • "Allow"            → window.gtConsent.grant()  then hide.
    • "Continue without" → window.gtConsent.deny()   then hide.
    • Can be reopened from anywhere via a click on a [data-gt-open-consent]
      element (e.g. the footer "Privacy settings" link) or the
      `gt:open-consent` event dispatched by window.gtConsent.openSettings().

  Non-blocking (aria-modal="false"): the page stays usable behind the subtle
  backdrop, and booking works regardless of the choice.
*/
import type { Lang } from '../i18n/strings';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;

const copy = {
  en: {
    title: 'Help improve Grounded Touch',
    body:
      'With your permission, I use optional detailed analytics to understand site use and which sources lead to bookings.',
    allow: 'Allow',
    allowAria: 'Allow analytics',
    decline: 'Continue without',
    declineAria: 'Continue without analytics',
    details: 'Details',
    hideDetails: 'Hide details',
    privacy: 'Privacy policy',
    dHeading: 'Detailed analytics',
    dUsed: 'Used to understand',
    used: [
      'pages viewed',
      'interactions with the website',
      'referral and campaign information',
      'whether visits lead to bookings',
    ],
    dInclude: 'May include',
    include: [
      'page interactions',
      'referral and campaign information',
      'short-lived random analytics identifiers',
      'booking funnel events',
      'browser and device information',
    ],
    dNot: 'Not used for',
    not: ['cross-site advertising profiles', 'selling personal data', 'tracking you across unrelated websites'],
    dNote: 'Basic reach measurement is described separately in the privacy policy.',
  },
  de: {
    title: 'Grounded Touch verbessern',
    body:
      'Mit Ihrer Erlaubnis nutze ich optionale detaillierte Analyse, um zu verstehen, wie die Website genutzt wird und welche Quellen zu Buchungen führen.',
    allow: 'Zulassen',
    allowAria: 'Analyse zulassen',
    decline: 'Ohne fortfahren',
    declineAria: 'Ohne Analyse fortfahren',
    details: 'Details',
    hideDetails: 'Details ausblenden',
    privacy: 'Datenschutz',
    dHeading: 'Detaillierte Analyse',
    dUsed: 'Wird genutzt, um zu verstehen',
    used: [
      'welche Seiten aufgerufen werden',
      'Interaktionen mit der Website',
      'Herkunfts- und Kampagneninformationen',
      'ob Besuche zu Buchungen führen',
    ],
    dInclude: 'Kann umfassen',
    include: [
      'Seiten-Interaktionen',
      'Herkunfts- und Kampagneninformationen',
      'kurzlebige, zufällige Analyse-Kennungen',
      'Ereignisse im Buchungsablauf',
      'Browser- und Geräteinformationen',
    ],
    dNot: 'Wird nicht genutzt für',
    not: ['seitenübergreifende Werbeprofile', 'den Verkauf personenbezogener Daten', 'die Verfolgung über fremde Websites hinweg'],
    dNote: 'Eine grundlegende Reichweitenmessung wird separat in der Datenschutzerklärung beschrieben.',
  },
}[lang];
---

<!-- Subtle backdrop: page stays clearly visible; no heavy blur/blackout.
     Hidden until the banner is shown so decided visitors never see a flash. -->
<div id="acp-backdrop" class="acp-backdrop" hidden></div>

<div
  id="acp"
  class="acp"
  role="dialog"
  aria-modal="false"
  aria-labelledby="acp-title"
  aria-describedby="acp-desc"
  hidden
>
  <div class="acp-card">
    <h2 id="acp-title" class="acp-title">{copy.title}</h2>

    <div id="acp-desc" class="acp-body">
      <p>{copy.body}</p>
    </div>

    <!-- Expandable details — hidden until the Details control is toggled. -->
    <div id="acp-details" class="acp-details" hidden>
      <div class="acp-rule"></div>
      <p class="acp-details-heading">{copy.dHeading}</p>

      <p class="acp-details-label acp-details-label--block">{copy.dUsed}</p>
      <ul class="acp-list">
        {copy.used.map((item) => <li>{item}</li>)}
      </ul>

      <p class="acp-details-label acp-details-label--block">{copy.dInclude}</p>
      <ul class="acp-list">
        {copy.include.map((item) => <li>{item}</li>)}
      </ul>

      <p class="acp-details-label acp-details-label--block">{copy.dNot}</p>
      <ul class="acp-list">
        {copy.not.map((item) => <li>{item}</li>)}
      </ul>

      <p class="acp-details-note">{copy.dNote}</p>
    </div>

    <div class="acp-actions">
      <button
        type="button"
        id="acp-allow"
        class="btn-primary acp-btn acp-btn--primary"
        aria-label={copy.allowAria}
      >
        {copy.allow}
      </button>
      <button
        type="button"
        id="acp-decline"
        class="btn-outline acp-btn acp-btn--secondary"
        aria-label={copy.declineAria}
      >
        {copy.decline}
      </button>
    </div>

    <div class="acp-meta">
      <button
        type="button"
        id="acp-details-toggle"
        class="acp-toggle"
        aria-expanded="false"
        aria-controls="acp-details"
        data-hide-label={copy.hideDetails}
      >
        {copy.details}
      </button>
      <a href="/datenschutz" class="acp-privacy">{copy.privacy}</a>
    </div>
  </div>
</div>

<style>
  /* ---- Subtle backdrop: ~10% dark, page stays clearly visible, no blur ---- */
  .acp-backdrop {
    position: fixed;
    inset: 0;
    z-index: 59; /* just beneath the panel */
    background: rgba(28, 22, 17, 0.10);
    pointer-events: none; /* page remains usable behind it (non-blocking) */
    animation: acp-fade 320ms ease both;
  }
  .acp-backdrop[hidden] { display: none; }

  /* ---- Layout: compact, contained bottom-center panel; page stays visible ---- */
  .acp {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    display: flex;
    justify-content: center;
    padding: 1rem 1rem calc(1.75rem + env(safe-area-inset-bottom, 0px));
    pointer-events: none; /* container is transparent; only the card is interactive */
  }
  .acp[hidden] { display: none; }

  .acp-card {
    pointer-events: auto;
    width: 100%;
    max-width: 37rem; /* ~592px — compact, contained on desktop */
    box-sizing: border-box;
    background: #FDFBF6;
    border: 1px solid #C8BCA3;
    border-radius: 16px;
    box-shadow: 0 18px 52px rgba(28, 22, 17, 0.22);
    padding: 1.2rem 1.35rem 1.1rem;
    animation: acp-in 420ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }

  @keyframes acp-in {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes acp-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ---- Type ---- */
  .acp-title {
    font-family: 'Fraunces', Georgia, serif;
    font-weight: 500;
    font-size: 1.3rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: #1C1611;
    margin: 0;
  }
  .acp-body {
    margin-top: 0.4rem;
    color: rgba(28, 22, 17, 0.78);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  /* ---- Details (accordion) ---- */
  .acp-details { margin-top: 0.8rem; }
  .acp-details[hidden] { display: none; }
  .acp-rule {
    height: 1px;
    width: 100%;
    background: #D8CDB8;
    margin-bottom: 0.8rem;
  }
  .acp-details-heading {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #6B6157;
    margin: 0 0 0.55rem;
  }
  .acp-details-label {
    font-weight: 600;
    color: #1C1611;
  }
  .acp-details-label--block {
    display: block;
    font-size: 0.8rem;
    margin: 0 0 0.3rem;
  }
  .acp-list {
    list-style: disc;
    padding-left: 1.15rem;
    margin: 0 0 0.7rem;
    font-size: 0.85rem;
    line-height: 1.45;
    color: rgba(28, 22, 17, 0.78);
  }
  .acp-list li { margin: 0.1rem 0; }
  .acp-list:last-child { margin-bottom: 0; }
  .acp-details-note {
    margin: 0.2rem 0 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: #6B6157;
  }

  /* ---- Actions: both choices clearly visible; no dark patterns ---- */
  .acp-actions {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .acp-btn {
    justify-content: center;
    cursor: pointer;
  }

  /* ---- Meta row: Details toggle + Privacy policy ---- */
  .acp-meta {
    margin-top: 0.7rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .acp-toggle {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    color: #1C1611;
    border-bottom: 1px solid rgba(28, 22, 17, 0.4);
    line-height: 1.4;
    transition: color 300ms cubic-bezier(0.22,0.61,0.36,1),
                border-color 300ms cubic-bezier(0.22,0.61,0.36,1);
  }
  .acp-toggle:hover { color: #A54A28; border-color: #A54A28; }
  .acp-privacy {
    font-size: 0.78rem;
    color: #6B6157;
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 300ms cubic-bezier(0.22,0.61,0.36,1);
  }
  .acp-privacy:hover { color: #1C1611; }

  /* ---- Accessibility: clear, color-independent focus ring ---- */
  .acp-card :focus-visible {
    outline: 2px solid #A54A28;
    outline-offset: 2px;
    border-radius: 6px;
  }

  /* ---- Mobile (phones, ~88% of traffic): compact bottom consent sheet ---- */
  @media (max-width: 480px) {
    .acp {
      padding: 0.75rem 0.875rem calc(0.875rem + env(safe-area-inset-bottom, 0px));
    }
    .acp-card {
      padding: 1rem 1.1rem 0.95rem;
    }
    .acp-title {
      font-size: clamp(1.55rem, 6.8vw, 1.72rem);
      line-height: 1.08;
    }
    .acp-body {
      margin-top: 0.3rem;
      font-size: 1rem;
      line-height: 1.4;
    }
    .acp-actions {
      flex-direction: row;   /* both choices on one horizontal row */
      flex-wrap: nowrap;
      gap: 0.5rem;
      margin-top: 0.55rem;
    }
    .acp-btn {
      flex: 1 1 0;
      min-width: 0;
      min-height: 50px;
      white-space: nowrap;
      text-align: center;
      padding-left: 0.9rem;
      padding-right: 0.9rem;
      font-size: 0.95rem;
    }
    .acp-btn--primary { flex-grow: 42; }
    .acp-btn--secondary { flex-grow: 58; }
    .acp-meta { margin-top: 0.5rem; }
    .acp-toggle,
    .acp-privacy { font-size: 0.9rem; }
    .acp-list { font-size: 0.9rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .acp-card,
    .acp-backdrop { animation: none; }
  }
</style>

<script>
  (function () {
    // Guard against double-wiring (Astro HMR / accidental double-include).
    if ((window as any).__gtConsentUiInit) return;
    (window as any).__gtConsentUiInit = true;

    var panel = document.getElementById('acp');
    var backdrop = document.getElementById('acp-backdrop');
    var allow = document.getElementById('acp-allow');
    var decline = document.getElementById('acp-decline');
    var toggle = document.getElementById('acp-details-toggle');
    var details = document.getElementById('acp-details');
    if (!panel) return;

    function show() {
      panel.hidden = false;
      if (backdrop) backdrop.hidden = false;
    }
    function hide() {
      panel.hidden = true;
      if (backdrop) backdrop.hidden = true;
    }

    // Read the consent cookie directly for the initial show decision, so this
    // does not depend on the load order of the analytics module. Show only when
    // the visitor is undecided (no granted/denied cookie).
    function decided() {
      try {
        return /(?:^|;\s*)gt_analytics_consent=(granted|denied)(?:;|$)/.test(document.cookie);
      } catch (e) {
        return false;
      }
    }
    if (!decided()) show();

    // "Allow" / "Continue without" — drive analytics ONLY through the central
    // consent API, then hide. (The API owns cookie, ids, events, Vercel.)
    allow &&
      allow.addEventListener('click', function () {
        try { (window as any).gtConsent && (window as any).gtConsent.grant(); } catch (e) {}
        hide();
      });
    decline &&
      decline.addEventListener('click', function () {
        try { (window as any).gtConsent && (window as any).gtConsent.deny(); } catch (e) {}
        hide();
      });

    // Details disclosure.
    if (toggle && details) {
      var labelDetails = toggle.textContent || 'Details';
      var labelHide = toggle.getAttribute('data-hide-label') || labelDetails;
      toggle.addEventListener('click', function () {
        var open = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!open));
        details.hidden = open;
        toggle.textContent = open ? labelDetails : labelHide;
      });
    }

    // Reopen from anywhere: a [data-gt-open-consent] control (footer "Privacy
    // settings") or the gt:open-consent event from gtConsent.openSettings().
    document.addEventListener('click', function (e) {
      var t = e.target && (e.target as Element).closest
        ? (e.target as Element).closest('[data-gt-open-consent]')
        : null;
      if (t) {
        e.preventDefault();
        show();
      }
    });
    document.addEventListener('gt:open-consent', show);
  })();
</script>
