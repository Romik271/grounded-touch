---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import ApproachShort from '../../components/sections/short/ApproachShort.astro';
import AboutShort from '../../components/sections/short/AboutShort.astro';
import LegsShort from '../../components/sections/short/LegsShort.astro';
import SessionsShort from '../../components/sections/short/SessionsShort.astro';
import ReviewsShort from '../../components/sections/short/ReviewsShort.astro';
import FaqShort from '../../components/sections/short/FaqShort.astro';
import CalExitFeedback from '../../components/CalExitFeedback.astro';
import { strings } from '../../i18n/strings';

const seo = strings.de.seo;
---

<BaseLayout lang="de" title={seo.title} description={seo.description}>
  <div id="short-hero-wrap">
    <Hero
      lang="de"
      trustMarker="Ausbildung in Chiang Mai, Thailand"
    />
  </div>
  <ApproachShort lang="de" />
  <AboutShort lang="de" />
  <LegsShort lang="de" />
  <SessionsShort lang="de" />
  <ReviewsShort lang="de" />
  <FaqShort lang="de" />

  <!-- Mobile-only sticky landing spot for the Hero "Book a session" button. -->
  <div id="short-hero-book-dock" aria-hidden="true"></div>

  {/* Exit-Feedback für das Cal-Buchungs-Overlay. Nutzt die bestehende
      WhatsApp-Adresse der Startseite + das bestehende whatsapp_contact-Event. */}
  <CalExitFeedback
    lang="de"
    whatsappHref="https://wa.me/4915233935530?text=Hi%20Roman%2C%20I%20would%20like%20to%20book%20a%20massage."
    whatsappTrack="whatsapp_contact"
  />

  <style>
    /* Hide the "Der Ansatz" secondary link inside the Hero on /de/. */
    :global(#short-hero-wrap a.btn-outline[href="#approach"]) {
      display: none;
    }
    /* Hide the trailing "→" arrow inside the Hero "Termin buchen" button. */
    :global(.short-hero-book-btn > span[aria-hidden="true"]) {
      display: none;
    }

    /* Mobile-only sticky landing spot — bottom-right of the viewport. */
    #short-hero-book-dock {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 40;
      pointer-events: none;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 300ms cubic-bezier(0.22, 0.61, 0.36, 1),
                  transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    #short-hero-book-dock.is-active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    @media (min-width: 768px) {
      #short-hero-book-dock {
        display: none !important;
      }
    }
  </style>

  <script>
    (function () {
      const heroWrap = document.getElementById('short-hero-wrap');
      const dock = document.getElementById('short-hero-book-dock');
      if (!heroWrap || !dock) return;

      const bookBtn = heroWrap.querySelector('.btn-primary[data-cal-link]');
      if (!bookBtn) return;
      bookBtn.classList.add('short-hero-book-btn');
      // Tracking: hero state vs docked (floating) state need separate button_ids.
      bookBtn.setAttribute('data-track', 'book_session_hero');

      const originalParent = bookBtn.parentNode;
      const originalNext = bookBtn.nextSibling;
      let isDocked = false;

      // Both hero AND docked (floating) state behave identically: instead of
      // opening Cal.com, smoothly scroll to the "Choose your time" (#sessions)
      // section so the visitor picks 60 / 90 min there. The floating button is
      // the SAME element reparented into the dock, so this one handler unifies
      // both — no second implementation, and no automatic Cal.com booking.
      // Analytics fires on a document-level *capture* listener (before this one),
      // so the tracking event (book_session_hero / book_session_floating) still
      // fires; stopPropagation only blocks Cal.com's document-level *bubble* handler.
      bookBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const target = document.getElementById('sessions');
        if (target) target.scrollIntoView({ behavior: 'smooth' });
      });

      const mediaQuery = window.matchMedia('(max-width: 767px)');

      const restoreBtn = () => {
        if (bookBtn.parentNode === dock) {
          originalParent.insertBefore(bookBtn, originalNext);
        }
        bookBtn.setAttribute('data-track', 'book_session_hero');
      };

      const dockBtn = () => {
        if (isDocked) return;
        isDocked = true;
        dock.appendChild(bookBtn);
        bookBtn.setAttribute('data-track', 'book_session_floating');
        void dock.offsetWidth;
        dock.classList.add('is-active');
      };

      const undockBtn = () => {
        if (!isDocked) return;
        isDocked = false;
        dock.classList.remove('is-active');
        setTimeout(() => {
          if (isDocked) return;
          restoreBtn();
        }, 300);
      };

      const reset = () => {
        isDocked = false;
        dock.classList.remove('is-active');
        restoreBtn();
      };

      // Visibility state. The floating shortcut is eligible only once the hero
      // (which contains the original top "Book a session" CTA) has scrolled
      // fully above the viewport, AND while neither the 60- nor the 90-minute
      // card is intersecting the viewport. That hides it over the cards (and the
      // small gap between them) and shows it both above and below the cards.
      let heroPassed = false;
      let cardsVisible = false;

      const update = () => {
        // Desktop: never dock (CSS also hides the dock >= 768px).
        if (!mediaQuery.matches) {
          reset();
          return;
        }
        if (heroPassed && !cardsVisible) {
          dockBtn();
        } else {
          undockBtn();
        }
      };

      // Hero: "passed" means scrolled FULLY above the viewport top — a position
      // test, so a hero still below the fold on a short screen does NOT count as
      // passed. IntersectionObserver fires only on crossings (no per-scroll
      // work) and also fires once right after observe(), covering initial load
      // and restored scroll positions.
      const heroObserver = new IntersectionObserver(
        (entries) => {
          const e = entries[0];
          if (!e) return;
          const rb = e.rootBounds;
          heroPassed =
            !e.isIntersecting && e.boundingClientRect.bottom <= (rb ? rb.top : 0);
          update();
        },
        { threshold: 0 },
      );
      heroObserver.observe(heroWrap);

      // Cards: any part of either stacked card visible → hide. Observing both
      // real card buttons (stable data-track attributes, no text matching)
      // covers a card taller than the viewport and the gap between the two.
      const cards = document.querySelectorAll(
        '#sessions button[data-track="book_60min"], #sessions button[data-track="book_90min"]',
      );
      if (cards.length) {
        const cardState = new WeakMap();
        const cardObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => cardState.set(e.target, e.isIntersecting));
            let anyVisible = false;
            cards.forEach((c) => {
              if (cardState.get(c)) anyVisible = true;
            });
            cardsVisible = anyVisible;
            update();
          },
          { threshold: 0 },
        );
        cards.forEach((c) => cardObserver.observe(c));
      }

      // Re-evaluate at the mobile/desktop boundary (orientation/resize that
      // changes element intersection is handled by the observers themselves).
      if (mediaQuery.addEventListener) {
        mediaQuery.addEventListener('change', update);
      } else if (mediaQuery.addListener) {
        // Safari <14 fallback.
        mediaQuery.addListener(update);
      }

      // Initial state (observers also fire shortly after observe()).
      update();
    })();
  </script>

  <script>
    // ---------------------------------------------------------------------
    // Scroll-depth tracking — fire scroll_25 / scroll_50 / scroll_75 once each
    // when the visitor first reaches that share of the page. Mirrors the
    // /hotel convention exactly: window.trackById(id, id) so the payload
    // schema, context (page_visit_id, journey_id, language, creative,
    // timestamp), delivery and Meta bot filtering are identical to every other
    // event — no new fields and no backend change. In-memory flags only (no
    // cookies/storage); each milestone fires at most once per page_visit_id
    // (one document load), even when scrolling back up and down. A scroll that
    // jumps across several thresholds records each newly crossed one once.
    // ---------------------------------------------------------------------
    (function () {
      var milestones = [
        { pct: 25, id: 'scroll_25' },
        { pct: 50, id: 'scroll_50' },
        { pct: 75, id: 'scroll_75' },
      ];
      var fired = {};

      function send(id) {
        // Only mark as fired once the event is actually dispatched, so a
        // not-yet-ready tracker (module load order) doesn't swallow a milestone.
        if (typeof (window as any).trackById !== 'function') return false;
        try {
          (window as any).trackById(id, id);
        } catch (e) { /* analytics must never break the page */ }
        return true;
      }

      function allFired() {
        return milestones.every(function (m) { return fired[m.pct]; });
      }

      function evaluate() {
        var doc = document.documentElement;
        var docH = Math.max(doc.scrollHeight, document.body.scrollHeight);
        var viewport = window.innerHeight || doc.clientHeight;
        // No scrollable range → never auto-fire thresholds.
        if (docH <= viewport) return;
        // % of the page the bottom of the viewport has reached (same depth
        // definition as /hotel).
        var pct = ((window.scrollY || doc.scrollTop) + viewport) / docH * 100;
        for (var i = 0; i < milestones.length; i++) {
          var m = milestones[i];
          if (!fired[m.pct] && pct >= m.pct && send(m.id)) {
            fired[m.pct] = true;
          }
        }
      }

      evaluate();
      window.addEventListener('scroll', evaluate, { passive: true });
      window.addEventListener('resize', evaluate);
      // Cover already-scrolled loads where trackById wasn't attached yet on the
      // first pass; stops as soon as everything has fired.
      var tries = 0;
      var iv = setInterval(function () {
        tries += 1;
        evaluate();
        if (allFired() || tries > 30) clearInterval(iv);
      }, 150);
    })();
  </script>
</BaseLayout>
