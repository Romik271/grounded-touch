---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Approach from '../components/sections/Approach.astro';
import Legs from '../components/sections/Legs.astro';
import Sessions from '../components/sections/Sessions.astro';
import Booking from '../components/sections/Booking.astro';
import FAQ from '../components/sections/FAQ.astro';
import About from '../components/sections/About.astro';
---

<BaseLayout noindex="noindex, follow">
  <Hero trustMarker="Trained in Chiang Mai, Thailand" />
  <Approach />
  <About />
  <Legs />
  <Sessions />
  <Booking />
  <FAQ />

  <!--
    /long ONLY — experimental booking-recovery test.
    Floating "Book a session" button that scrolls to the #sessions section
    (it does NOT open Cal directly), plus a non-blocking bottom sheet shown
    when a visitor opens a Cal widget, views it, then closes it without booking.
  -->

  <!-- Floating "Book a session" button (long page only). -->
  <button
    id="long-float-book"
    type="button"
    data-track="book_session_floating"
    class="btn-primary"
    aria-label="Book a session"
  >
    Book a session
  </button>

  <!-- Booking-recovery bottom sheet (compact, non-blocking, no overlay). -->
  <div
    id="booking-recovery"
    role="dialog"
    aria-modal="false"
    aria-labelledby="booking-recovery-title"
    aria-hidden="true"
  >
    <div class="booking-recovery-card">
      <button
        type="button"
        class="booking-recovery-close"
        data-track="booking_recovery_closed"
        aria-label="Close"
      >
        <svg width="16" height="16" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M2 2l14 14M16 2L2 16" />
        </svg>
      </button>
      <h2 id="booking-recovery-title" class="font-serif text-xl md:text-2xl text-ink pr-8">Any questions?</h2>
      <p class="mt-2 text-ink/75 leading-relaxed">
        Didn't find the right time or want to check something before booking?
      </p>
      <a
        href="https://wa.me/4917645718382?text=Hi%20Roman%2C%20quick%20question%20%F0%9F%99%82"
        target="_blank"
        rel="noopener noreferrer"
        data-track="booking_recovery_whatsapp"
        class="mt-4 inline-flex items-center gap-2 rounded-full bg-ink text-ivory px-6 py-3 text-sm transition-colors duration-500 ease-gentle hover:bg-terra"
      >
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.447h.006c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411m-8.475 18.297h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.975 1.001-3.635-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.459-9.887 9.942-9.887 2.654 0 5.148 1.032 7.021 2.905a9.82 9.82 0 0 1 2.909 6.99c-.002 5.45-4.458 9.878-9.935 9.878"/>
        </svg>
        <span>Ask me on WhatsApp</span>
      </a>
    </div>
  </div>

  <style>
    /* Floating book button — fixed bottom-right, hidden until scrolled past hero. */
    #long-float-book {
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      z-index: 40; /* above content, below the recovery sheet (z-50) */
      opacity: 0;
      transform: translateY(8px);
      pointer-events: none;
      transition: opacity 300ms cubic-bezier(0.22, 0.61, 0.36, 1),
                  transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1);
    }
    #long-float-book.is-active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    /* Hidden while the recovery sheet is visible so the two never overlap. */
    #long-float-book.is-suppressed {
      opacity: 0 !important;
      transform: translateY(8px) !important;
      pointer-events: none !important;
    }

    /* Bottom sheet — compact card, slides up, no full-screen overlay. */
    #booking-recovery {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50; /* above the floating button and page content */
      display: flex;
      justify-content: center;
      padding: 1rem;
      pointer-events: none; /* container is transparent; only the card is interactive */
    }
    .booking-recovery-card {
      position: relative;
      width: 100%;
      max-width: 26rem;
      background: var(--paper, #FBF8F1);
      background: #FBF8F1;
      border: 1px solid rgba(28, 25, 23, 0.12);
      border-radius: 14px;
      box-shadow: 0 10px 40px rgba(28, 25, 23, 0.18);
      padding: 1.25rem 1.25rem 1.35rem;
      transform: translateY(140%);
      transition: transform 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
      pointer-events: auto;
    }
    #booking-recovery.is-visible .booking-recovery-card {
      transform: translateY(0);
    }
    .booking-recovery-close {
      position: absolute;
      top: 0.75rem;
      right: 0.75rem;
      width: 2rem;
      height: 2rem;
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(28, 25, 23, 0.55);
      transition: color 300ms ease;
    }
    .booking-recovery-close:hover {
      color: rgba(28, 25, 23, 0.9);
    }
    @media (prefers-reduced-motion: reduce) {
      #long-float-book,
      .booking-recovery-card {
        transition: none;
      }
    }
  </style>

  <script>
    (function () {
      // ---------------------------------------------------------------------
      // /long ONLY — booking-recovery bottom sheet + floating button.
      // In-memory guards only (no cookies / storage / persistent ids).
      // ---------------------------------------------------------------------
      var floatBtn = document.getElementById('long-float-book');
      var sheet = document.getElementById('booking-recovery');
      if (!floatBtn || !sheet) return;

      var card = sheet.querySelector('.booking-recovery-card');
      var closeBtn = sheet.querySelector('.booking-recovery-close');
      var sessions = document.getElementById('sessions');
      var heroSection = document.querySelector('main section');

      // ----- Floating button: scroll to #sessions (does NOT open Cal) -----
      floatBtn.addEventListener('click', function () {
        if (sessions) sessions.scrollIntoView({ behavior: 'smooth' });
      });

      // Show the floating button once the hero has scrolled out of view.
      var floatSuppressed = false; // hidden because the sheet is showing
      function evaluateFloat() {
        if (floatSuppressed) return;
        var pastHero = true;
        if (heroSection) {
          pastHero = heroSection.getBoundingClientRect().bottom <= 0;
        }
        floatBtn.classList.toggle('is-active', pastHero);
      }
      evaluateFloat();
      window.addEventListener('scroll', evaluateFloat, { passive: true });
      window.addEventListener('resize', evaluateFloat);

      // ----- Recovery state (in-memory only) -----
      var recoveryShownThisPage = false; // once per page load
      var widgetViewed = false;          // current opening was viewed/loaded
      var bookingSucceeded = false;      // success during current opening
      var sheetVisible = false;

      function track(id) {
        try {
          if (typeof window.trackById === 'function') window.trackById(id);
        } catch (e) { /* analytics must never break the page */ }
      }

      function showSheet() {
        if (recoveryShownThisPage || sheetVisible) return;
        recoveryShownThisPage = true;
        sheetVisible = true;
        sheet.setAttribute('aria-hidden', 'false');
        // Force reflow so the slide-up transition runs from the hidden state.
        void card.offsetWidth;
        sheet.classList.add('is-visible');
        // Hide the floating button so the two never overlap.
        floatSuppressed = true;
        floatBtn.classList.add('is-suppressed');
        track('booking_recovery_shown');
      }

      function hideSheet() {
        if (!sheetVisible) return;
        sheetVisible = false;
        sheet.classList.remove('is-visible');
        sheet.setAttribute('aria-hidden', 'true');
        // Restore the floating button (if still scrolled past the hero).
        floatSuppressed = false;
        floatBtn.classList.remove('is-suppressed');
        evaluateFloat();
      }

      // Close button: analytics fires via its data-track ("booking_recovery_closed")
      // through the existing delegated listener, so we only handle the UI here.
      if (closeBtn) {
        closeBtn.addEventListener('click', function () { hideSheet(); });
      }

      // ----- Cal.com official embed events (public) -----
      // Opening is considered "viewed/loaded" via bookerViewed / bookerReady.
      // bookingSuccessfulV2 marks the opening as completed.
      function onOpeningViewed() {
        widgetViewed = true;
        bookingSucceeded = false; // reset success for this fresh opening
      }
      function onBookingSuccess() {
        bookingSucceeded = true;
        // If the sheet somehow slipped through, close it immediately.
        if (sheetVisible) hideSheet();
      }

      // Cal is initialized lazily (only after a booking button is clicked), so
      // register these listeners once it is ready. If Cal is already initialized
      // (e.g. the inline calendar on this page called calEmbedInit), run now;
      // otherwise queue until calEmbedInit flushes __calOnReady.
      function registerCalListeners() {
        try {
          if (!window.Cal || !window.Cal.ns) return;
          ['sixty', 'ninety'].forEach(function (ns) {
            var api = window.Cal.ns[ns];
            if (typeof api !== 'function') return;
            api('on', { action: 'bookerViewed', callback: onOpeningViewed });
            api('on', { action: 'bookerReady', callback: onOpeningViewed });
            api('on', { action: 'bookerReopened', callback: onOpeningViewed });
            api('on', { action: 'bookingSuccessfulV2', callback: onBookingSuccess });
          });
        } catch (e) { /* best-effort; never break the page */ }
      }
      if (window.__calReady) {
        registerCalListeners();
      } else {
        window.__calOnReady = window.__calOnReady || [];
        window.__calOnReady.push(registerCalListeners);
      }

      // ----- Reliable close signal (parent-page element, NOT the iframe) -----
      // Cal.com appends a <cal-modal-box> element to THIS document and sets
      // state="closed" on it when the user closes the popup. We observe that
      // parent-page attribute only — we never read or touch the iframe DOM.
      // __closeIframe is the only internal close event and is not public, so
      // this parent-side state attribute is the reliable public-surface signal.
      function handleClose() {
        if (!widgetViewed) return;       // never opened/viewed this time
        widgetViewed = false;            // this opening has ended
        if (bookingSucceeded) return;    // completed booking -> no recovery
        if (recoveryShownThisPage) return;
        showSheet();
      }

      function inspectModalNode(node) {
        try {
          if (!node || node.nodeType !== 1) return;
          if (node.tagName !== 'CAL-MODAL-BOX') return;
          if (node.getAttribute('state') === 'closed') handleClose();
        } catch (e) { /* silently ignore shape changes */ }
      }

      try {
        var mo = new MutationObserver(function (mutations) {
          for (var i = 0; i < mutations.length; i++) {
            var m = mutations[i];
            if (m.type === 'attributes') {
              inspectModalNode(m.target);
            } else if (m.type === 'childList') {
              for (var j = 0; j < m.addedNodes.length; j++) {
                inspectModalNode(m.addedNodes[j]);
              }
            }
          }
        });
        mo.observe(document.body, {
          subtree: true,
          childList: true,
          attributes: true,
          attributeFilter: ['state'],
        });
      } catch (e) { /* if unavailable, recovery sheet simply never shows */ }
    })();
  </script>
</BaseLayout>
