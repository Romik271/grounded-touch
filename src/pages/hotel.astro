---
import HotelLayout from '../layouts/HotelLayout.astro';
import EditorialImage from '../components/EditorialImage.astro';
import AskQuestion from '../components/sections/AskQuestion.astro';

// ── Hotel booking destination ───────────────────────────────────────────────
// Dedicated Cal.com event for HOTEL sessions (90 min / €160). Used ONLY by the
// "Book your session" CTA inside the price card, which opens it as an in-page
// popup via the same embed implementation as the homepage (see HotelLayout).
// It must NEVER point at the standard 60/90-min Schwabing events.
//
// The embed expects the Cal link in path form (no https://cal.com/ prefix),
// exactly like the homepage session buttons (SessionsShort.astro).
const HOTEL_CAL_LINK = 'grounded-touch/mobile-massage-session-90-min-160';
const HOTEL_CAL_NAMESPACE = 'hotel';

// Shared contact URLs (existing project conventions).
const WHATSAPP_BOOK =
  'https://wa.me/4915233935530?text=Hi%20Roman%2C%20I%20would%20like%20to%20book%20a%20hotel%20massage.';
const WHATSAPP_ASK =
  'https://wa.me/4915233935530?text=Hi%20Roman%2C%20I%20have%20a%20question%20about%20a%20hotel%20massage.';

const steps = [
  { n: '01', title: 'Choose your time', text: 'Book your preferred session time.' },
  { n: '02', title: 'Tell me your hotel', text: 'Provide the hotel name and address when booking.' },
  { n: '03', title: 'I come to you', text: 'I arrive with the massage mat and complete setup.' },
  { n: '04', title: 'Your session', text: '90 minutes of attentive Thai massage in the privacy of your room.' },
];

const brings = [
  'Professional Thai massage mat',
  'Clean linens',
  'Cushions and support',
  'Everything needed for the session',
];

// Reviews — exact content + attribution reused from the existing site
// (ReviewsShort.astro). Hand-picked (not randomized) for the hotel context:
// each communicates trust, attentiveness, professionalism or comfort. Nothing
// here is invented or rewritten.
const googleReviewsUrl =
  'https://www.google.com/maps/place/Grounded+Touch+Massage/@48.163404,11.4184631,11z/data=!4m8!3m7!1s0x6ce2ecc61bd60bc5:0xa21970b570f4f98a!8m2!3d48.1635223!4d11.5836108!9m1!1b1!16s%2Fg%2F11zctqjhqs!5m1!1e2';
const reviews = [
  {
    name: 'Matze Dawedla',
    initials: 'MD',
    text: "Roman is an excellent masseur! You'll just need a place where you can lie down, he takes care of the rest. His thai massages are highly individual to your needs, whether your legs hurt from the last hike, or your shoulders and neck are tense from your exhausting day at the office. If you're around Munich and would like to try out a Thai massage at the comfort of your own home, definitely give it a go!",
  },
  {
    name: 'André Lameiras',
    initials: 'AL',
    text: 'I’m wholeheartedly giving Roman 5 stars. I felt comfortable from the start, particularly as I had some concerns that are normal with a first visit. Roman was very accommodating and really makes sure he listens to you. He checks in throughout the session to see how you’re feeling, and you can really tell that he pays attention to how your body responds to specific movements and stretches. I’ll definitely be back on a regular basis.\n\nIt’s also worth noting that, despite working quite deeply on some areas, I felt no soreness the following day. Overall, a very relaxing experience.',
  },
  {
    name: 'Natalia Hanhart-Alabyan',
    initials: 'NH',
    text: 'Fantastic Thai massage! Roman is very professional and skilled, and the atmosphere was clean and relaxing. I left feeling refreshed and much better. Highly recommended-I’ll definitely be back!',
  },
];
---

<HotelLayout>
  <!-- ============================= HERO ============================= -->
  <section class="bg-ivory">
    <div class="container-editorial pt-4 md:pt-8 pb-8 md:pb-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center">
        <div class="lg:col-span-7 reveal">
          <h1 class="h-display">
            Traditional Thai Massage<br /><span class="text-stone">in Your Hotel</span>
          </h1>

          <p class="mt-6 lede">
            Private mobile sessions in Munich.
          </p>
          <p class="mt-4 lede">
            I come to your hotel with a professional Thai massage mat and everything needed for the session.
          </p>

          <div class="mt-8 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3">
            <a href="#booking" id="hotel-hero-book" data-track="hotel_booking_hero" class="btn-primary justify-center">
              Book a hotel session
              <span aria-hidden="true">→</span>
            </a>
          </div>

          <p class="mt-6 flex items-center gap-2 text-[14px] md:text-[15px] leading-tight text-stone">
            <span class="flex items-center gap-0.5 text-terra" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <svg width="14" height="14" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                  <path d="M6 .75l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.633 2.91 10.259l.59-3.44L1 4.382l3.455-.502L6 .75z" />
                </svg>
              ))}
            </span>
            <span>5.0 on Google</span>
          </p>
        </div>

        <div class="lg:col-span-5">
          <EditorialImage
            src="/images/hero-opt.jpg"
            webp="/images/hero-opt.webp"
            avif="/images/hero-opt.avif"
            alt="Roman giving a traditional Thai massage on a floor mat in a calm, plant-filled room in Munich"
            ratio="3/4"
            variant="stone"
            priority
          />
        </div>
      </div>
    </div>
    <div class="container-editorial"><div class="rule"></div></div>
  </section>

  <!-- ========================= INTRO / EXPERIENCE ========================= -->
  <section class="bg-ivory pt-10 md:pt-14 pb-6 md:pb-8">
    <div class="container-editorial grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-4 reveal">
        <div class="index-label">The session</div>
      </div>
      <div class="md:col-span-8 reveal">
        <h2 class="h-section max-w-2xl">
          Thai massage, without leaving your hotel.
        </h2>
        <p class="mt-6 text-ink/75 leading-relaxed max-w-prose2">
          A private 90-minute Thai massage in your hotel room, adapted to how your body feels that day.
        </p>
      </div>
    </div>
  </section>

  <!-- =========================== ABOUT ROMAN =========================== -->
  <section class="bg-ivory py-8 md:py-12 border-t border-line">
    <div class="container-editorial grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-4 reveal">
        <div class="index-label">Your practitioner</div>
        <h2 class="h-section mt-4">Your practitioner.</h2>
      </div>
      <div class="md:col-span-8 reveal grid grid-cols-1 sm:grid-cols-12 gap-8">
        <div class="sm:col-span-5">
          <EditorialImage
            src="/images/about-opt.jpg"
            alt="Portrait of Roman, traditional Thai massage practitioner in Munich"
            ratio="4/5"
            variant="stone"
          />
        </div>
        <div class="sm:col-span-7 text-ink/75 leading-relaxed max-w-prose2">
          <p>My name is Roman.</p>
          <p class="mt-3">
            I trained in traditional Thai massage in Chiang Mai, Thailand. My approach is calm, attentive and adapted to the person in front of me.
          </p>
          <p class="mt-3 text-ink/60">
            Certified by Ong’s Thai Massage School, Chiang Mai — Traditional Thai Massage and Foot Massage &amp; Reflexology.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================== CAROUSEL =========================== -->
  <section class="bg-ivory pt-2 pb-8 md:pb-12">
    <div class="container-editorial">
      <div
        data-hotel-carousel
        role="group"
        aria-label="Thai massage sessions in Munich"
        class="hotel-carousel"
      >
        {[
          { src: '/images/hotel-carousel-1-opt.jpg', alt: 'Roman giving a traditional Thai foot massage outdoors in a Munich park' },
          { src: '/images/hotel-carousel-2-opt.jpg', alt: 'Traditional Thai massage stretch performed on a mat' },
          { src: '/images/hotel-carousel-3-opt.jpg', alt: 'Roman working on the shoulders during a seated Thai massage' },
        ].map((img) => (
          <div class="hotel-carousel__item">
            <div class="hotel-carousel__frame">
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <style>
    /* Mobile: horizontal swipe carousel with scroll snap. Each item is a fixed
       88% of the viewport so a sliver of the next image peeks in. Explicit
       flex-basis + width so the items can never collapse to 0. */
    .hotel-carousel {
      display: flex;
      gap: 1rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .hotel-carousel::-webkit-scrollbar { display: none; }

    .hotel-carousel__item {
      flex: 0 0 88%;
      width: 88%;
      scroll-snap-align: start;
    }

    .hotel-carousel__frame {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      overflow: hidden;
      border-radius: 6px;
      background-color: #EDE6D7;
    }
    .hotel-carousel__frame img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Desktop: three equal columns in one row, no horizontal scroll. */
    @media (min-width: 768px) {
      .hotel-carousel {
        gap: 1.25rem;
        overflow-x: visible;
      }
      .hotel-carousel__item {
        flex: 1 1 0;
        width: auto;
        min-width: 0;
      }
    }
  </style>

  <!-- =========================== WHAT I BRING =========================== -->
  <section class="bg-ivory py-8 md:py-12 border-t border-line">
    <div class="container-editorial grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      <div class="md:col-span-4 reveal">
        <div class="index-label">What I bring</div>
        <h2 class="h-section mt-4">What I bring.</h2>
      </div>
      <div class="md:col-span-8 reveal">
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-4">
          {brings.map((item) => (
            <li class="flex items-start gap-3 border-b border-line pb-4 text-ink/85">
              <span class="mt-2 block w-1 h-1 rounded-full bg-terra flex-shrink-0"></span>
              <span class="text-lg">{item}</span>
            </li>
          ))}
        </ul>
        <p class="mt-6 text-ink/70 leading-relaxed max-w-prose2">
          Traditional Thai massage is performed without oil.
        </p>
      </div>
    </div>
  </section>

  <!-- =========================== HOW IT WORKS =========================== -->
  <section class="bg-ivory py-8 md:py-12 border-t border-line">
    <div class="container-editorial">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-6 md:mb-10">
        <div class="md:col-span-4 reveal">
          <div class="index-label">How it works</div>
        </div>
        <div class="md:col-span-8 reveal">
          <h2 class="h-section max-w-2xl">How it works.</h2>
        </div>
      </div>

      <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-line border border-line rounded-[6px] overflow-hidden">
        {steps.map((s) => (
          <li class="reveal bg-ivory p-6 md:p-8">
            <span class="index-num">{s.n}</span>
            <h3 class="font-serif text-xl md:text-2xl text-ink mt-3 leading-tight">{s.title}</h3>
            <p class="mt-3 text-ink/70 leading-relaxed">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ======================= HOTEL SESSION / PRICE ======================= -->
  <section id="booking" class="bg-ivory py-8 md:py-12 border-t border-line scroll-mt-24">
    <div class="container-editorial">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-6 md:mb-10">
        <div class="md:col-span-4 reveal">
          <div class="index-label">Booking</div>
        </div>
        <div class="md:col-span-8 reveal">
          <h2 class="h-section max-w-2xl">Your hotel session.</h2>
        </div>
      </div>

      <div class="reveal bg-paper rounded-[6px] px-6 md:px-10 py-8 md:py-12">
        <div class="grid grid-cols-12 gap-6 md:gap-10 items-start">
          <div class="col-span-3 md:col-span-2">
            <span class="font-serif text-5xl md:text-7xl text-ink tabular-nums leading-none">90</span>
            <span class="ml-2 index-label">min</span>
          </div>
          <div class="col-span-9 md:col-span-7">
            <h3 class="font-serif text-2xl md:text-3xl text-ink leading-tight">Private Hotel Thai Massage</h3>
            <p class="mt-3 text-ink/70 leading-relaxed max-w-prose2">
              Includes travel within central Munich, transport and setup of the professional massage mat, and a private 90-minute session in your hotel room.
            </p>
          </div>
          <div class="col-span-12 md:col-span-3 flex items-baseline justify-between md:justify-end gap-6">
            <div>
              <span class="font-serif text-4xl md:text-5xl text-terra tabular-nums leading-none">160</span>
              <span class="ml-1 text-2xl md:text-3xl text-terra">€</span>
            </div>
          </div>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-4">
          <button
            type="button"
            data-cal-link={HOTEL_CAL_LINK}
            data-cal-namespace={HOTEL_CAL_NAMESPACE}
            data-cal-config='{"layout":"month_view"}'
            data-track="hotel_booking_price"
            class="btn-primary justify-center"
          >
            Book your session
            <span aria-hidden="true">→</span>
          </button>

          <!-- Secondary, subtle contact option. Stays visually secondary to the
               booking CTA above. -->
          <a
            href={WHATSAPP_ASK}
            target="_blank"
            rel="noopener noreferrer"
            data-track="hotel_whatsapp"
            class="inline-flex items-center gap-2 text-sm text-ink/70 hover:text-terra transition-colors duration-500 ease-gentle"
          >
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M20.52 3.449C18.24 1.245 15.24 0 12.045 0 5.463 0 .104 5.334.101 11.892c0 2.096.549 4.14 1.595 5.945L0 24l6.335-1.652c1.746.943 3.71 1.444 5.71 1.447h.006c6.585 0 11.946-5.336 11.949-11.896 0-3.176-1.24-6.165-3.495-8.411m-8.475 18.297h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.975 1.001-3.635-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.002-5.45 4.459-9.887 9.942-9.887 2.654 0 5.148 1.032 7.021 2.905a9.82 9.82 0 0 1 2.909 6.99c-.002 5.45-4.458 9.878-9.935 9.878"/>
            </svg>
            Ask on WhatsApp
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= REVIEWS ============================= -->
  <section class="bg-ivory py-8 md:py-12 border-t border-line">
    <div class="container-editorial">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-6 md:mb-10">
        <div class="md:col-span-4 reveal">
          <div class="index-label">Reviews</div>
        </div>
        <div class="md:col-span-8 reveal">
          <h2 class="h-section max-w-2xl">What clients say.</h2>
          <a
            href={googleReviewsUrl}
            target="_blank"
            rel="noopener noreferrer"
            data-track="see_google_review"
            class="mt-5 inline-flex items-center gap-3 text-sm text-ink/80 hover:text-ink transition-colors duration-500 ease-gentle"
          >
            <span class="flex items-center gap-0.5 text-terra" aria-label="5 out of 5 stars">
              {Array.from({ length: 5 }).map(() => (
                <svg width="13" height="13" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                  <path d="M6 .75l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.633 2.91 10.259l.59-3.44L1 4.382l3.455-.502L6 .75z" />
                </svg>
              ))}
            </span>
            <span class="tabular-nums">5.0</span>
            <span class="text-stone/60" aria-hidden="true">·</span>
            <span class="inline-flex items-center gap-1.5">
              on
              <svg aria-hidden="true" width="13" height="13" viewBox="0 0 24 24" class="opacity-90">
                <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.44c-.28 1.42-1.1 2.63-2.33 3.45v2.85h3.77c2.2-2.03 3.61-5.02 3.61-8.54z"/>
                <path fill="#34A853" d="M12 24c3.15 0 5.79-1.05 7.72-2.83l-3.77-2.85c-1.05.7-2.39 1.12-3.95 1.12-3.04 0-5.62-2.05-6.54-4.81H1.55v2.94C3.48 21.31 7.42 24 12 24z"/>
                <path fill="#FBBC05" d="M5.46 14.63c-.23-.7-.37-1.44-.37-2.23s.14-1.53.37-2.23V7.23H1.55A11.98 11.98 0 000 12.4c0 1.9.45 3.7 1.25 5.29l4.21-3.06z"/>
                <path fill="#EA4335" d="M12 4.75c1.71 0 3.25.59 4.47 1.75l3.35-3.35C17.79 1.26 15.15 0 12 0 7.42 0 3.48 2.69 1.55 6.6l3.91 3.06C6.38 6.9 8.96 4.75 12 4.75z"/>
              </svg>
              <span>Google</span>
            </span>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
        {reviews.map((r) => (
          <div data-review-card class="review-card reveal bg-paper rounded-[6px] px-5 md:px-7 py-6 md:py-8 flex flex-col">
            <div class="flex items-center gap-3">
              <span
                aria-hidden="true"
                class="flex-shrink-0 w-9 h-9 rounded-full border border-ink/15 bg-ivory flex items-center justify-center font-serif text-xs text-ink/75 tracking-widelabel"
              >
                {r.initials}
              </span>
              <div class="min-w-0 flex-1">
                <div class="font-serif text-base md:text-lg text-ink leading-tight truncate">{r.name}</div>
                <div class="mt-0.5 flex items-center gap-2">
                  <span class="flex items-center gap-0.5 text-terra" aria-label="5 out of 5 stars">
                    {Array.from({ length: 5 }).map(() => (
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="currentColor" aria-hidden="true">
                        <path d="M6 .75l1.545 3.13 3.455.502-2.5 2.437.59 3.44L6 8.633 2.91 10.259l.59-3.44L1 4.382l3.455-.502L6 .75z" />
                      </svg>
                    ))}
                  </span>
                  <span class="index-label !text-[10px] !tracking-widelabel text-stone">Google review</span>
                </div>
              </div>
              <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" class="flex-shrink-0 opacity-90">
                <path fill="#4285F4" d="M23.49 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.44c-.28 1.42-1.1 2.63-2.33 3.45v2.85h3.77c2.2-2.03 3.61-5.02 3.61-8.54z"/>
                <path fill="#34A853" d="M12 24c3.15 0 5.79-1.05 7.72-2.83l-3.77-2.85c-1.05.7-2.39 1.12-3.95 1.12-3.04 0-5.62-2.05-6.54-4.81H1.55v2.94C3.48 21.31 7.42 24 12 24z"/>
                <path fill="#FBBC05" d="M5.46 14.63c-.23-.7-.37-1.44-.37-2.23s.14-1.53.37-2.23V7.23H1.55A11.98 11.98 0 000 12.4c0 1.9.45 3.7 1.25 5.29l4.21-3.06z"/>
                <path fill="#EA4335" d="M12 4.75c1.71 0 3.25.59 4.47 1.75l3.35-3.35C17.79 1.26 15.15 0 12 0 7.42 0 3.48 2.69 1.55 6.6l3.91 3.06C6.38 6.9 8.96 4.75 12 4.75z"/>
              </svg>
            </div>

            <div class="review-body mt-4">
              <p class="review-text text-ink/80 leading-relaxed whitespace-pre-line">
                {r.text}
              </p>
              <a
                href={googleReviewsUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-review-toggle
                data-track="read_full_comment"
                aria-expanded="false"
                aria-label={`Read the full review from ${r.name} on Google`}
                class="review-link text-[13px] text-terra transition-colors duration-500 ease-gentle hover:text-ink"
              >
                <span class="review-link-label" data-collapsed-label>Read full review</span>
                <span class="review-link-label hidden" data-expanded-label>Read on Google</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

    <style>
      .review-body {
        position: relative;
        overflow: hidden;
        transition: max-height 400ms cubic-bezier(0.22, 0.61, 0.36, 1);
      }
      .review-text {
        display: -webkit-box;
        -webkit-line-clamp: 5;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .review-link {
        display: block;
        text-align: right;
        margin-top: 0.75rem;
      }
      .review-card.is-expanded .review-body {
        overflow: visible !important;
        max-height: none !important;
      }
      .review-card.is-expanded .review-text {
        display: block !important;
        -webkit-line-clamp: none !important;
        -webkit-box-orient: horizontal !important;
        overflow: visible !important;
        max-height: none !important;
      }
    </style>

    <script>
      (function () {
        const cards = document.querySelectorAll('[data-review-card]');
        const setLabels = (toggle, expanded) => {
          const collapsedLabel = toggle.querySelector('[data-collapsed-label]');
          const expandedLabel = toggle.querySelector('[data-expanded-label]');
          if (!collapsedLabel || !expandedLabel) return;
          collapsedLabel.classList.toggle('hidden', expanded);
          expandedLabel.classList.toggle('hidden', !expanded);
          toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
          toggle.setAttribute('data-track', expanded ? 'see_google_review' : 'read_full_comment');
        };
        const expand = (card) => {
          const body = card.querySelector('.review-body');
          const toggle = card.querySelector('[data-review-toggle]');
          if (!body || !toggle) return;
          const startHeight = body.scrollHeight;
          body.style.maxHeight = startHeight + 'px';
          void body.offsetHeight;
          card.classList.add('is-expanded');
          setLabels(toggle, true);
          body.style.maxHeight = body.scrollHeight + 'px';
          const done = () => {
            body.style.maxHeight = '';
            body.removeEventListener('transitionend', done);
          };
          body.addEventListener('transitionend', done);
        };
        cards.forEach((card) => {
          const toggle = card.querySelector('[data-review-toggle]');
          if (!toggle) return;
          toggle.addEventListener('click', (e) => {
            if (card.classList.contains('is-expanded')) return; // second click → navigate to Google
            e.preventDefault();
            expand(card);
          });
        });
      })();
    </script>
  </section>

