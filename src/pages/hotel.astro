    id="hotel-float-book"
    href="#booking"
    data-track="hotel_booking_floating"
    class="btn-primary md:hidden"
    aria-label="Book a session"
  >
    Book a session
  </a>

  <style>
    /* Floating book button — MOBILE ONLY. All positioning lives inside the
       mobile media query so it never overrides the `md:hidden` utility on
       larger screens (an id selector would otherwise win on specificity).
       Fixed near the bottom, hidden until the hero has scrolled out of view. */
    @media (max-width: 767px) {
      #hotel-float-book {
        position: fixed;
        right: 16px;
        bottom: 20px;
        z-index: 50;
        width: auto;
        min-width: 150px;
        height: 50px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        box-shadow: 0 8px 24px rgba(28, 22, 17, 0.28);
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
        transition: opacity 300ms cubic-bezier(0.22, 0.61, 0.36, 1),
                    transform 300ms cubic-bezier(0.22, 0.61, 0.36, 1);
      }
      #hotel-float-book.is-active {
        opacity: 1;
        transform: translateY(0);
        pointer-events: auto;
      }
    }
  </style>

  <script>
    // ---------------------------------------------------------------------
    // Page impression — fire ONE "page_view" event per load via the existing
    // analytics tracker (window.trackById). Same payload schema as every other
    // event; no new fields, no cookies/storage, endpoint unchanged. An in-memory
    // window flag guarantees it fires only once.
    // ---------------------------------------------------------------------
    (function () {
      if ((window as any).__hotelPageViewTracked) return;
      function fire() {
        if ((window as any).__hotelPageViewTracked) return true;
        if (typeof (window as any).trackById !== 'function') return false;
        (window as any).__hotelPageViewTracked = true;
        try {
          (window as any).trackById('hotel_page_view', 'page_view');
        } catch (e) { /* analytics must never break the page */ }
        return true;
      }
      if (fire() !== true) {
        // trackById may not be attached yet (module load order); retry briefly.
        var tries = 0;
        var iv = setInterval(function () {
          tries += 1;
          if (fire() === true || tries > 50) clearInterval(iv);
        }, 100);
      }
    })();

    // ---------------------------------------------------------------------
    // Floating "Book now" button — reveal once the hero has scrolled away.
    // Clicking the anchor opens the hotel booking flow directly (its href);
    // no click handler needed, and tracking fires via the delegated
    // [data-track] listener (button_id: hotel_book_floating).
    // ---------------------------------------------------------------------
    (function () {
      var floatBtn = document.getElementById('hotel-float-book');
      if (!floatBtn) return;
      var hero = document.querySelector('main section');
      function evaluate() {
        var pastHero = true;
        if (hero) pastHero = hero.getBoundingClientRect().bottom <= 0;
        floatBtn.classList.toggle('is-active', pastHero);
      }
      evaluate();
      window.addEventListener('scroll', evaluate, { passive: true });
      window.addEventListener('resize', evaluate);
    })();

    // ---------------------------------------------------------------------
    // Hero + floating "Book" CTAs — smoothly scroll to the "Your hotel session"
    // (#booking) section instead of opening Cal.com directly. Matches the
    // homepage hero/floating interaction. Analytics fires on the document-level
    // *capture* listener before this bubble handler, so the tracking events
    // (hotel_booking_hero / hotel_booking_floating) still fire; preventDefault
    // just cancels the native #hash jump so the scroll is smooth.
    // ---------------------------------------------------------------------
    (function () {
      ['hotel-hero-book', 'hotel-float-book'].forEach(function (elId) {
        var btn = document.getElementById(elId);
        if (!btn) return;
        btn.addEventListener('click', function (e) {
          e.preventDefault();
          e.stopPropagation();
          var target = document.getElementById('booking');
          if (target) target.scrollIntoView({ behavior: 'smooth' });
        });
      });
    })();

    // ---------------------------------------------------------------------
    // Scroll-depth tracking — fire scroll_25 / scroll_50 / scroll_75 / scroll_90
    // once each when the visitor first reaches that share of the page. Uses the
    // existing analytics tracker (window.trackById), so the payload schema,
    // referrer and endpoint are identical to every other event — no new fields.
    // In-memory flags only (no cookies/storage); each milestone fires only once
    // per load, even when scrolling back up and down.
    // ---------------------------------------------------------------------
    (function () {
      var milestones = [
        { pct: 25, id: 'scroll_25' },
        { pct: 50, id: 'scroll_50' },
        { pct: 75, id: 'scroll_75' },
        { pct: 90, id: 'scroll_90' },
      ];
      var fired = {};

      function send(id) {
        // Only mark as fired once the event is actually dispatched, so a
        // not-yet-ready tracker (module load order) doesn't swallow a milestone.
        if (typeof (window as any).trackById !== 'function') return false;
        try {
          (window as any).trackById(id, id);
        } catch (e) { /* analytics must never break the page */ }
        return true;
      }

      function allFired() {
        return milestones.every(function (m) { return fired[m.pct]; });
      }

      function evaluate() {
        var doc = document.documentElement;
        var docH = Math.max(doc.scrollHeight, document.body.scrollHeight);
        var viewport = window.innerHeight || doc.clientHeight;
        // % of the page the bottom of the viewport has reached. A page shorter
        // than the viewport counts as fully seen.
        var pct = docH <= viewport
          ? 100
          : ((window.scrollY || doc.scrollTop) + viewport) / docH * 100;
        for (var i = 0; i < milestones.length; i++) {
          var m = milestones[i];
          if (!fired[m.pct] && pct >= m.pct && send(m.id)) {
            fired[m.pct] = true;
          }
        }
      }

      evaluate();
      window.addEventListener('scroll', evaluate, { passive: true });
      window.addEventListener('resize', evaluate);
      // Cover short/already-scrolled pages where trackById wasn't attached yet
      // on the first pass; stops as soon as everything has fired.
      var tries = 0;
      var iv = setInterval(function () {
        tries += 1;
        evaluate();
        if (allFired() || tries > 30) clearInterval(iv);
      }, 150);
    })();
  </script>

  <script>
    // Track the accordion open-click ONCE (matches the site convention): keep
    // data-track while closed, strip it on open so the closing click is silent,
    // then re-arm on close. Applies to the hotel FAQ rows only. The ask-question
    // row (hotel_faq_ask_question) is left untouched — its own script owns it.
    document.querySelectorAll('section details').forEach((details) => {
      const summary = details.querySelector('summary');
      if (!summary) return;
      const trackId = summary.getAttribute('data-track');
      if (!trackId || trackId === 'hotel_faq_ask_question') return;
      details.addEventListener('toggle', () => {
        if (details.open) summary.removeAttribute('data-track');
        else summary.setAttribute('data-track', trackId);
      });
    });
  </script>
