---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum - Grounded Touch" description="Impressum / legal notice for Grounded Touch, Munich.">
  <section class="bg-bone py-24 md:py-32">
    <div class="container-tight">
      <div class="eyebrow mb-6">Legal</div>
      <h1 class="font-serif text-4xl md:text-6xl leading-tight mb-16">Impressum</h1>

      <div class="space-y-12 text-ink/80 leading-relaxed font-light">
        <div>
          <p class="font-medium text-ink mb-3">Roman Bashmakov</p>
          <p>
            Roman Bashmakov (Einzelunternehmer)<br />
            Sulzbacher Str. 4<br />
            80803 München
          </p>
        </div>

        <div>
          <div class="eyebrow mb-3">Kontakt</div>
          <p>
            Telefon: +4915233935530<br />
            E-Mail: <a href="mailto:roman.bashmakov.es@gmail.com" class="border-b border-clay/50 hover:border-ink">roman.bashmakov.es@gmail.com</a>
          </p>
        </div>

        <div>
          <div class="eyebrow mb-3">Berufsbezeichnung und berufsrechtliche Regelungen</div>
          <p>
            Berufsbezeichnung:<br />
            anderer Beruf
          </p>
        </div>

        <div>
          <div class="eyebrow mb-3">Verbraucherstreitbeilegung/Universalschlichtungsstelle</div>
          <p>
            Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer
            Verbraucherschlichtungsstelle teilzunehmen.
          </p>
        </div>

        <p class="text-sm text-stone pt-8">
          Quelle:<br />
          <a href="https://www.e-recht24.de/impressum-generator.html" class="border-b border-clay/50 hover:border-ink" target="_blank" rel="noopener">https://www.e-recht24.de/impressum-generator.html</a>
        </p>
      </div>

      <a href="/" class="btn-ghost mt-16">← Back</a>
    </div>
  </section>
</BaseLayout>
