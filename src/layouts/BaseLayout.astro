---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

import type { Lang } from '../i18n/strings';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
  noindex?: boolean | string;
}

const {
  title = 'Thai Massage in Munich Schwabing | Grounded Touch',
  description = 'Thai massage in Munich Schwabing, in a calm private space. Attentive sessions for tired legs, tense muscles, and the whole body. Book 60 or 90 minute appointments online.',
  lang = 'en',
  noindex = false,
} = Astro.props;

const robotsContent =
  typeof noindex === 'string' ? noindex : (noindex ? 'noindex,nofollow' : null);

const path = Astro.url.pathname;
const isHome =
  path === '/' || path === '' ||
  path === '/de/' || path === '/de' ||
  path === '/long/' || path === '/long';
const showHreflang =
  path === '/' || path === '' ||
  path === '/de/' || path === '/de';
const canonicalUrl = new URL(path, Astro.site).href;
const ogImageUrl = new URL('/images/hero-opt.jpg', Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    <meta name="theme-color" content="#F4EFE6" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* No preconnect to app.cal.com: embed.js is loaded lazily on first booking
        click, so opening a connection on load would defeat the zero-request goal
        (and can set the Cloudflare __cf_bm cookie before any interaction). */}
    {isHome && <link rel="preload" as="image" href="/images/hero-opt.webp" type="image/webp" fetchpriority="high" />}
    <link rel="preload" as="font" type="font/woff2" href="/fonts/fraunces-latin.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin.woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {showHreflang && (
      <>
        <link rel="alternate" hreflang="en" href="https://www.groundedtouch.de/" />
        <link rel="alternate" hreflang="de" href="https://www.groundedtouch.de/de/" />
        <link rel="alternate" hreflang="x-default" href="https://www.groundedtouch.de/" />
      </>
    )}
    <title>{title}</title>

    <script is:inline>
      (function (C, A, L) {
        let p = function (a, ar) { a.q.push(ar); };
        let d = C.document;
        C.Cal = C.Cal || function () {
          let cal = C.Cal;
          let ar = arguments;
          if (!cal.loaded) {
            cal.ns = {};
            cal.q = cal.q || [];
            d.head.appendChild(d.createElement("script")).src = A;
            cal.loaded = true;
          }
          if (ar[0] === L) {
            const api = function () { p(api, arguments); };
            const namespace = ar[1];
            api.q = api.q || [];
            if (typeof namespace === "string") {
              cal.ns[namespace] = cal.ns[namespace] || api;
              p(cal.ns[namespace], ar);
              p(cal, ["initNamespace", namespace]);
            } else p(cal, ar);
            return;
          }
          p(cal, ar);
        };
      })(window, "https://app.cal.com/embed/embed.js", "init");

      // NOTE: defining the Cal stub above makes NO network request — embed.js is
      // only downloaded the first time Cal() is actually invoked. We deliberately
      // do NOT call Cal("init", ...) on load, so a fresh homepage visit makes zero
      // requests to app.cal.com and sets no .cal.com cookies until the visitor
      // clicks a booking button.

      // Idempotent lazy initializer: on first invocation it triggers the embed.js
      // download (via the first Cal() call), initializes both namespaces, and
      // registers the official embed events mapped to our existing analytics
      // (window.trackById). Safe to call again — it no-ops after the first run.
      window.__calReady = false;
      window.__calOnReady = window.__calOnReady || [];
      window.calEmbedInit = function () {
        if (window.__calReady) return;
        window.__calReady = true;

        Cal("init", "sixty", { origin: "https://cal.com" });
        Cal.ns.sixty("ui", { hideEventTypeDetails: false, layout: "month_view" });

        Cal("init", "ninety", { origin: "https://cal.com" });
        Cal.ns.ninety("ui", { hideEventTypeDetails: false, layout: "month_view" });

        // Cal.com Embed Events API → existing analytics. Registered per namespace
        // (sixty, ninety) before any popup opens, so bookerViewed/Ready fire after.
        var track = function (buttonId) {
          if (typeof window.trackById === "function") window.trackById(buttonId);
        };
        var calEvents = {
          bookerViewed: "cal_opened",
          bookerReady: "cal_loaded",
          bookingSuccessfulV2: "booking_completed",
        };
        ["sixty", "ninety"].forEach(function (ns) {
          Object.keys(calEvents).forEach(function (action) {
            Cal.ns[ns]("on", {
              action: action,
              callback: function () { track(calEvents[action]); },
            });
          });
        });

        // Flush any callbacks waiting for Cal to be initialized (e.g. /long
        // booking-recovery listeners).
        var q = window.__calOnReady || [];
        window.__calOnReady = [];
        q.forEach(function (cb) { try { cb(); } catch (e) {} });
      };

      // Lazy open: load embed.js + init only on the FIRST click of a booking
      // button, then open that button's popup. Bubble phase, exactly like
      // embed.js's own handler — so the homepage hero button (which calls
      // stopPropagation to scroll instead of book when not docked) never
      // triggers a load. Once embed.js is present (Cal.loaded), its own handler
      // opens popups, so we step aside to avoid opening twice.
      document.addEventListener("click", function (e) {
        var target = e.target && e.target.closest ? e.target.closest("[data-cal-link]") : null;
        if (!target) return;
        if (window.Cal && window.Cal.loaded) return; // embed.js already loaded → native handler opens it
        var calLink = target.getAttribute("data-cal-link");
        var ns = target.getAttribute("data-cal-namespace");
        var config = {};
        try { config = JSON.parse(target.getAttribute("data-cal-config") || ""); } catch (_) { config = {}; }
        window.calEmbedInit(); // appends embed.js + inits namespaces (sets Cal.loaded=true)
        var api = ns ? window.Cal.ns[ns] : window.Cal;
        if (api) api("modal", { calLink: calLink, config: config });
      });
    </script>
  </head>
  <body>
    <Nav lang={lang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      import '../scripts/analytics.ts';

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
    <Analytics />
  </body>
</html>
